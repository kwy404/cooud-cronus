## Dashboard block — Analytics
## Native .cronus only. No markup, no style_block, no template.

app "Cronus Analytics" {
  port 5301
  database sqlite "./analytics.db"
  theme dark
}

style {
  theme dark
  accent white
  font "Inter"
}

layout Main {
  sidebar {
    brand "Cronus"
    "Overview" -> "/" icon:home
    "Analytics" -> "/" icon:monitoring
    "Reports" -> "/reports" icon:description
    "Settings" -> "/settings" icon:settings
  }
}

entity Revenue {
  month string!
  revenue money!
}

entity Activity {
  customer string!
  email email!
  amount money!
  status enum [paid, pending, refunded]
}

page "/" type:dashboard {
  title "Analytics"

  section page-header {
    title "Analytics"
    subtitle "Performance across your workspace"
  }

  section kpi {
    item "Total revenue" value:"$84,210"
    item "Active users" value:"12,840"
    item "Conversion" value:"4.21%"
    item "Churn" value:"1.64%"
  }

  section chart {
    title "Revenue trend"
    subtitle "Monthly recurring revenue"
    type bar
    bind Revenue { aggregate sum field:revenue group_by:month }
  }

  section table {
    title "Recent activity"
    subtitle "Latest invoices and payments"
    columns "customer, amount, status"
    bind Activity { query all }
  }
}
