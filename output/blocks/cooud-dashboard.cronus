## Cooud Dashboard — dashboard.cooud.com in native .cronus
## cronus parse must succeed. Product surface.

app "Cooud" {
  port 4747
  database sqlite "./cooud.db"
  theme dark
}

style {
  theme dark
  accent white
  font "Inter"
}

page "/" type:custom {
  section sidebar {
    brand "Cooud"
    item "Home" -> "/" icon:home active:true
    item "Analytics" -> "/analytics" icon:monitoring
    item "History" -> "/history" icon:schedule
    item "Share" -> "/share" icon:share
    item "Apps" -> "/apps" icon:apps
    item "Settings" -> "/settings" icon:settings
  }

  section kpi {
    title "Saldo"
    value "-R$ 0,23"
    item "Receita bruta" value:"R$ 0,00"
    item "Receita liquida" value:"R$ 0,00"
    item "Pedidos" value:"0"
    item "Ticket medio bruto" value:"R$ 0,00"
  }

  section progress {
    title "Meta de faturamento"
    value "0"
    max "100000"
  }

  section tabs {
    item "Transacoes"
    item "Resumo"
  }

  section chart {
    title "Este mes"
    value "R$ 0,00"
  }

  section layout {
    style_block ":root { --bg: #07070b; --rail: #0b0b10; --stage: #0e0e14; --card: #14141c; --card-2: #12121a; --line: rgba(255,255,255,.07); --fg: #f4f4f5; --muted: #8b8b96; --dim: #5c5c66; --green: #3ee07a; --green-dim: rgba(62,224,122,.14); --radius: 18px; --ease: cubic-bezier(.22,1,.36,1); } * { box-sizing: border-box; } html, body { margin: 0; height: 100%; } body { background: #050508; color: var(--fg); font-family: 'SF Pro Text', Geist, -apple-system, BlinkMacSystemFont, system-ui, sans-serif; font-weight: 400; } .app { display: grid; grid-template-columns: 64px 1fr; height: 100vh; background: var(--bg); } .rail { display: flex; flex-direction: column; align-items: center; padding: 14px 0 16px; gap: 8px; } .logo { width: 40px; height: 40px; border-radius: 14px; background: #f5f5f7; color: #111; display: grid; place-items: center; margin-bottom: 10px; } .rail a { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; color: #9a9aa6; text-decoration: none; } .rail a:hover { background: #16161e; color: #fff; } .rail a.active { background: #181822; color: #fff; } .rail .gear { width: 40px; height: 40px; border-radius: 99px; background: #14141c; border: 1px solid var(--line); } .rail .spacer { flex: 1; } .rail svg { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; } .stage { margin: 10px 12px 12px 0; background: var(--stage); border: 1px solid var(--line); border-radius: 22px; display: grid; grid-template-rows: 56px 1fr; min-width: 0; overflow: hidden; position: relative; } .top { display: flex; justify-content: flex-end; align-items: center; gap: 8px; padding: 10px 16px 0; } .orb { width: 34px; height: 34px; border-radius: 99px; background: radial-gradient(circle at 30% 30%, #ffb4f0, #7ae7ff 45%, #ffd36a 80%); } .theme { display: flex; align-items: center; gap: 2px; height: 34px; padding: 3px; border-radius: 99px; border: 1px solid var(--line); background: #12121a; } .theme button { width: 28px; height: 28px; border: 0; border-radius: 99px; background: transparent; color: #8b8b96; display: grid; place-items: center; cursor: pointer; } .theme button.on { background: #1c1c26; color: #eee; } .theme svg { width: 14px; height: 14px; } .chip { width: 34px; height: 34px; border-radius: 99px; border: 1px solid var(--line); background: #14141c; display: grid; place-items: center; color: #cfcfd6; } .chip svg { width: 15px; height: 15px; } .ava { width: 34px; height: 34px; border-radius: 99px; object-fit: cover; } .body { display: grid; grid-template-columns: 280px 1fr; gap: 12px; padding: 8px 14px 14px; min-height: 0; } .col { display: flex; flex-direction: column; gap: 10px; min-height: 0; } .card { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 14px; } .saldo-h { display: flex; justify-content: space-between; align-items: center; color: var(--muted); font-size: 12px; } .saldo-h .left { display: flex; gap: 6px; align-items: center; } .badge { font-size: 11px; color: var(--green); background: var(--green-dim); border-radius: 99px; padding: 3px 8px; display: inline-flex; gap: 4px; align-items: center; } .money { font-size: 34px; letter-spacing: -0.04em; margin: 10px 0 8px; font-weight: 400; } .boost { display: flex; justify-content: space-between; font-size: 10px; letter-spacing: .08em; color: var(--dim); text-transform: uppercase; margin-bottom: 6px; } .meta-row { display: flex; justify-content: space-between; font-size: 11px; color: var(--muted); margin-bottom: 12px; } .btns { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 14px; } .btn { height: 44px; border-radius: 12px; border: 1px solid var(--line); background: #0c0c12; color: var(--fg); font: inherit; font-size: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; cursor: pointer; } .btn.primary { background: #0a0a10; box-shadow: inset 0 0 0 1px rgba(255,255,255,.04); } .btn svg { width: 14px; height: 14px; opacity: .8; } .stat { display: flex; align-items: center; gap: 10px; padding: 8px 2px; font-size: 13px; } .stat .ico { width: 28px; height: 28px; border-radius: 99px; background: #1a1a22; display: grid; place-items: center; color: var(--muted); } .stat .ico svg { width: 14px; height: 14px; } .stat b { margin-left: auto; font-weight: 400; } .goal { padding: 12px; flex: 1; display: flex; flex-direction: column; } .goal h3 { margin: 0 0 10px; font-size: 10px; letter-spacing: .12em; color: var(--dim); font-weight: 500; } .poster { flex: 1; min-height: 220px; border-radius: 12px; overflow: hidden; background: #08080c center 42%/170% no-repeat; box-shadow: 0 0 40px rgba(180,140,60,.12); } .goal-foot { display: flex; justify-content: space-between; font-size: 11px; color: var(--muted); margin: 10px 0 6px; } .bar { height: 3px; background: #22222c; border-radius: 99px; overflow: hidden; } .bar i { display: block; height: 100%; width: 0.4%; background: #e8e8ee; } .main { background: var(--card-2); border: 1px solid var(--line); border-radius: 16px; display: flex; flex-direction: column; min-width: 0; position: relative; overflow: hidden; } .toolbar { display: flex; align-items: center; gap: 8px; padding: 12px 14px; } .seg { display: flex; background: #101018; border: 1px solid var(--line); border-radius: 99px; padding: 3px; } .seg button { border: 0; background: transparent; color: var(--muted); font: inherit; font-size: 11px; letter-spacing: .06em; text-transform: uppercase; padding: 6px 12px; border-radius: 99px; cursor: pointer; } .seg button.on { background: #f4f4f5; color: #111; } .filters { margin-left: auto; display: flex; gap: 8px; } .dd { height: 34px; padding: 0 12px; border-radius: 10px; border: 1px solid var(--line); background: #12121a; color: var(--fg); font: inherit; font-size: 12px; display: flex; align-items: center; gap: 8px; } .chart { flex: 1; position: relative; padding: 8px 20px 36px; } .now { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--muted); } .now b { color: var(--fg); font-weight: 400; font-size: 14px; } .dot { width: 7px; height: 7px; border-radius: 99px; background: #fff; box-shadow: 0 0 0 3px rgba(255,255,255,.12); } .axis-line { height: 1px; background: var(--line); margin-top: 10px; } .axis { position: absolute; left: 20px; right: 20px; bottom: 14px; display: flex; justify-content: space-between; color: var(--dim); font-size: 11px; } .blob { position: absolute; right: 18px; bottom: 28px; width: 110px; height: 80px; background: radial-gradient(circle at 35% 40%, #ffb8e8 0%, transparent 55%), radial-gradient(circle at 70% 60%, #c9a0ff 0%, transparent 50%), radial-gradient(circle at 50% 70%, #7ad7ff 0%, transparent 45%); filter: blur(10px); opacity: .9; pointer-events: none; border-radius: 40% 60% 50% 50%; }"
    template "<div class=\"app\" id=\"cooud-dash\"> <nav class=\"rail\" aria-label=\"Principal\"> <div class=\"logo\" aria-label=\"Cooud\"> <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\"><path d=\"M6 9l6 6 6-6\" stroke=\"#111\" stroke-width=\"2.4\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg> </div> <a class=\"active\" href=\"#\" aria-current=\"page\" aria-label=\"Início\"> <svg viewBox=\"0 0 24 24\"><path d=\"M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1z\"/></svg> </a> <a href=\"#\" aria-label=\"Analytics\"> <svg viewBox=\"0 0 24 24\"><path d=\"M4 19V10M10 19V5M16 19v-7M22 19V8\"/></svg> </a> <a href=\"#\" aria-label=\"Histórico\"> <svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"8\"/><path d=\"M12 8v5l3 2\"/></svg> </a> <a href=\"#\" aria-label=\"Rede\"> <svg viewBox=\"0 0 24 24\"><circle cx=\"6\" cy=\"12\" r=\"2\"/><circle cx=\"18\" cy=\"7\" r=\"2\"/><circle cx=\"18\" cy=\"17\" r=\"2\"/><path d=\"M8 12h8M16.5 8.5 8.5 11M16.5 15.5 8.5 13\"/></svg> </a> <a href=\"#\" aria-label=\"Apps\"> <svg viewBox=\"0 0 24 24\"><rect x=\"4\" y=\"4\" width=\"6\" height=\"6\" rx=\"1\"/><rect x=\"14\" y=\"4\" width=\"6\" height=\"6\" rx=\"1\"/><rect x=\"4\" y=\"14\" width=\"6\" height=\"6\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"6\" height=\"6\" rx=\"1\"/></svg> </a> <div class=\"spacer\"></div> <a class=\"gear\" href=\"#\" aria-label=\"Ajustes\"> <svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4\"/></svg> </a> </nav> <section class=\"stage\"> <div class=\"top\"> <div class=\"orb\" aria-hidden=\"true\"></div> <div class=\"theme\" role=\"group\" aria-label=\"Tema\"> <button type=\"button\" aria-label=\"Claro\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 3v2M12 19v2M5 12H3M21 12h-2\"/></svg></button> <button class=\"on\" type=\"button\" aria-label=\"Escuro\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><path d=\"M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z\"/></svg></button> </div> <button class=\"chip\" type=\"button\" aria-label=\"Notificações\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><path d=\"M6 16v-5a6 6 0 1 1 12 0v5l1.5 2H4.5z\"/><path d=\"M10 20a2 2 0 0 0 4 0\"/></svg></button> <img class=\"ava\" alt=\"\" src=\"https://i.pravatar.cc/64?img=12\" /> </div> <div class=\"body\"> <div class=\"col\"> <div class=\"card\"> <div class=\"saldo-h\"> <span class=\"left\"> <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><rect x=\"5\" y=\"3\" width=\"14\" height=\"18\" rx=\"2\"/><path d=\"M9 8h6M9 12h6M9 16h3\"/></svg> Saldo </span> <span class=\"badge\">✦ Auto + D3</span> </div> <div class=\"money\">-R$ 0,23</div> <div class=\"boost\"><span>Boost</span><span>Meta do dia</span></div> <div class=\"meta-row\"><span>Faltam hoje R$ 110,00</span><span>Meta diária R$ 110,00</span></div> <div class=\"btns\"> <button class=\"btn primary\" type=\"button\"> <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><path d=\"M8 7h12M4 12h16M8 17h12\"/></svg> Transações </button> <button class=\"btn\" type=\"button\"> <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><rect x=\"4\" y=\"5\" width=\"16\" height=\"14\" rx=\"2\"/><path d=\"M8 5V3M16 5V3M4 10h16\"/></svg> Repasses </button> </div> <div class=\"stat\"><span class=\"ico\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><path d=\"M12 3v18M16 8H10.5a2.5 2.5 0 0 0 0 5H14a2.5 2.5 0 0 1 0 5H8\"/></svg></span> Receita bruta <b>R$ 0,00</b></div> <div class=\"stat\"><span class=\"ico\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><path d=\"M4 19V5M4 19h16M8 15l3-4 3 2 4-6\"/></svg></span> Receita líquida <b>R$ 0,00</b></div> <div class=\"stat\"><span class=\"ico\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><circle cx=\"9\" cy=\"20\" r=\"1.5\"/><circle cx=\"18\" cy=\"20\" r=\"1.5\"/><path d=\"M3 4h2l2.2 11h11L21 7H7\"/></svg></span> Pedidos <b>0</b></div> <div class=\"stat\"><span class=\"ico\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><rect x=\"5\" y=\"3\" width=\"14\" height=\"18\" rx=\"2\"/><path d=\"M9 8h6M9 12h6\"/></svg></span> Ticket médio bruto <b>R$ 0,00</b></div> </div> <div class=\"card goal\"> <h3>Meta de faturamento</h3> <div class=\"poster\" style=\"background-image:url('cooud-titanium.jpg')\"></div> <div class=\"goal-foot\"> <span>Receita líquida · todos os projetos</span> </div> <div class=\"goal-foot\" style=\"margin-top:0\"> <span>R$ 0,00</span><span>R$ 100.000,00</span> </div> <div class=\"bar\"><i></i></div> </div> </div> <div class=\"main\"> <div class=\"toolbar\"> <div class=\"seg\"> <button class=\"on\" type=\"button\">Transações</button> <button type=\"button\">Resumo</button> </div> <div class=\"filters\"> <div class=\"dd\">📅 Este mês</div> <div class=\"dd\">⌂ Todos os projetos</div> </div> </div> <div class=\"chart\"> <div class=\"now\"><span class=\"dot\"></span> Este mês <b>R$ 0,00</b></div> <div class=\"axis-line\"></div> <div class=\"blob\"></div> <div class=\"axis\"> <span>01 de set.</span><span>02 de set.</span><span>03 de set.</span> <span>04 de set.</span><span>05 de set.</span><span>06 de set.</span><span>07 de set.</span> </div> </div> </div> </div> </section> </div>"
  }
}
