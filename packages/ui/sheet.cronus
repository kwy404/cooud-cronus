## Sheet
## source: packages/ui/src/components/sheet.tsx
## behavior: native component (state, items, tests). Kernel renders.
## exports: Sheet, SheetTrigger, SheetClose, SheetContent, SheetHeader, SheetFooter, SheetTitle, SheetDescription
## slots: sheet-close, sheet-content, sheet-description, sheet-footer, sheet-header, sheet-overlay, sheet-title
## variants.side: top, bottom, left, right

component Sheet(label: text, disabled: boolean, open: boolean) layout:overlay style:sheet {
  label "Sheet"
  state open: boolean = false
  title "Sheet"
  action "open"
  action "close"
  action "focus"

  test "opens Sheet" {
    click "open"
    click "close"
  }
  test "disabled Sheet" {
    expect visible "Sheet"
  }
}

