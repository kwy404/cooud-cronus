## Chip
## source: packages/ui/src/components/chip.tsx
## behavior: native component (state, items, tests). Kernel renders.
## exports: ChipLabels, Chip, ChipGroup
## slots: chip, chip-avatar, chip-check, chip-group, chip-icon, chip-remove
## variants.variant: solid, soft, outline
## variants.color: neutral, primary, success, warning, error, info
## variants.size: sm, md, lg
## variants.interactive: true, false
## variants.selected: true, false

component Chip(label: text, disabled: boolean, variant: text, size: text) layout:inline style:chip {
  label "Chip"
  variant "soft"
  size "md"
  action "click"
  action "focus"

  test "uses Chip" {
    click "Chip"
  }
  test "disabled Chip" {
    expect visible "Chip"
  }
}

component ChipLabels(label: text, disabled: boolean) layout:inline style:chip-labels {
  label "ChipLabels"
  action "click"
}

component ChipGroup(label: text, disabled: boolean) layout:inline style:chip-group {
  label "ChipGroup"
  action "click"
}
