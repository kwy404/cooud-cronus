## Toggle
## source: packages/ui/src/components/toggle.tsx
## behavior: native component (state, items, tests). Kernel renders.
## exports: Toggle
## slots: toggle
## variants.variant: default, outline
## variants.size: sm, md, lg

component Toggle(label: text, disabled: boolean, variant: text, size: text, checked: boolean) layout:inline style:toggle+default+md {
  label "Toggle"
  variant "default"
  size "md"
  state checked: boolean = false
  action "toggle"
  action "focus"

  test "toggles Toggle" {
    click "Toggle"
  }
  test "disabled Toggle" {
    expect visible "Toggle"
  }
}

component ToggleOutline(label: text, disabled: boolean) layout:inline style:toggle+outline+md {
  label "Toggle"
  variant "outline"
  action "click"
}
