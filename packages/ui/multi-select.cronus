## MultiSelect
## source: packages/ui/src/components/multi-select.tsx
## behavior: native component (state, items, tests). Kernel renders.
## exports: MultiSelect
## slots: multi-select-chip-remove, multi-select-clear, multi-select-indicator, multi-select-trigger

component MultiSelect(label: text, disabled: boolean, value: text, invalid: boolean) layout:inline style:multi-select {
  label "MultiSelect"
  state value: text = ""
  field "MultiSelect"
  action "focus"

  test "fills MultiSelect" {
    fill value "x"
  }
  test "disabled MultiSelect" {
    expect visible "MultiSelect"
  }
}
