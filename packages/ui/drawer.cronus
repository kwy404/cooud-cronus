## Drawer
## source: packages/ui/src/components/drawer.tsx
## behavior: native component (state, items, tests). Kernel renders.
## exports: Drawer, DrawerTrigger, DrawerPortal, DrawerClose, DrawerOverlay, DrawerContent, DrawerHeader, DrawerFooter, DrawerTitle, DrawerDescription
## slots: drawer, drawer-content, drawer-description, drawer-footer, drawer-header, drawer-overlay, drawer-title

component Drawer(label: text, disabled: boolean, open: boolean) layout:overlay style:drawer {
  label "Drawer"
  state open: boolean = false
  title "Drawer"
  action "open"
  action "close"
  action "focus"

  test "opens Drawer" {
    click "open"
    click "close"
  }
  test "disabled Drawer" {
    expect visible "Drawer"
  }
}

