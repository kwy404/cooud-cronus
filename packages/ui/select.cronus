## Select
## source: packages/ui/src/components/select.tsx
## behavior: native component (state, items, tests). Kernel renders.
## exports: Select, SelectGroup, SelectValue, SelectTrigger, SelectScrollUpButton, SelectScrollDownButton, SelectContent, SelectLabel, SelectItem, SelectSeparator
## slots: select-content, select-item, select-label, select-scroll-down-button, select-scroll-up-button, select-separator, select-trigger

component Select(label: text, disabled: boolean, value: text, invalid: boolean) layout:inline style:select {
  label "Select"
  state value: text = ""
  field "Select"
  action "focus"

  test "fills Select" {
    fill value "x"
  }
  test "disabled Select" {
    expect visible "Select"
  }
}

