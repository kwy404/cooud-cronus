component Alert(label: text, disabled: boolean, variant: text) layout:inline style:alert {
  label "Alert"
  variant "default"
  action "click"
  action "focus"

  test "uses Alert" {
    click "Alert"
  }
  test "disabled Alert" {
    expect visible "Alert"
  }
}

