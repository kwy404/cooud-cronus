  label "ToggleGroup"
  state checked: boolean = false
  action "toggle"
  action "focus"

  test "toggles ToggleGroup" {
    click "ToggleGroup"
  }
  test "disabled ToggleGroup" {
    expect visible "ToggleGroup"
  }
}

