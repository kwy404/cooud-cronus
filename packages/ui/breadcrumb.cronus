component Breadcrumb(label: text, disabled: boolean) layout:stack style:breadcrumb {
  label "Breadcrumb"
  item "Home" -> "/"
  item "Next" -> "/next"
  action "navigate"
  action "focus"

  test "navigates Breadcrumb" {
    click "Home"
  }
  test "disabled Breadcrumb" {
    expect visible "Breadcrumb"
  }
}

