component Pagination(label: text, disabled: boolean) layout:stack style:pagination {
  label "Pagination"
  item "Home" -> "/"
  item "Next" -> "/next"
  action "navigate"
  action "focus"

  test "navigates Pagination" {
    click "Home"
  }
  test "disabled Pagination" {
    expect visible "Pagination"
  }
}

