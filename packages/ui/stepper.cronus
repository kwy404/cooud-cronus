## Stepper
## source: packages/ui/src/components/stepper.tsx
## behavior: native component (state, items, tests). Kernel renders.
## exports: StepperLabels, Stepper, StepperList, StepperItem, StepperIndicator, StepperSeparator, StepperTrigger, StepperTitle, StepperDescription
## slots: stepper, stepper-description, stepper-indicator, stepper-item, stepper-item-state, stepper-list, stepper-separator, stepper-title, stepper-trigger
## variants.state: completed, active, upcoming

component Stepper(label: text, disabled: boolean, value: text) layout:stack style:stepper {
  label "Stepper"
  state value: text = "one"
  tab "one"
  tab "two"
  tab "three"
  action "focus"

  test "switches Stepper" {
    click "two"
  }
  test "disabled Stepper" {
    expect visible "Stepper"
  }
}

