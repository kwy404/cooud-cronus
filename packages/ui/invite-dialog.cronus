  label "InviteDialog"
  state open: boolean = false
  title "InviteDialog"
  action "open"
  action "close"
  action "focus"

  test "opens InviteDialog" {
    click "open"
    click "close"
  }
  test "disabled InviteDialog" {
    expect visible "InviteDialog"
  }
}

