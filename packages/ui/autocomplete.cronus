## Autocomplete
## source: packages/ui/src/components/autocomplete.tsx
## behavior: native component (state, items, tests). Kernel renders.
## exports: Autocomplete
## slots: autocomplete, autocomplete-command, autocomplete-content, autocomplete-input, autocomplete-loading, autocomplete-spinner

component Autocomplete(label: text, disabled: boolean, value: text, invalid: boolean) layout:inline style:autocomplete {
  label "Autocomplete"
  state value: text = ""
  field "Autocomplete"
  action "focus"

  test "fills Autocomplete" {
    fill value "x"
  }
  test "disabled Autocomplete" {
    expect visible "Autocomplete"
  }
}
