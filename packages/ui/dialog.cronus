## Dialog
## source: packages/ui/src/components/dialog.tsx
## behavior: native component (state, items, tests). Kernel renders.
## exports: Dialog, DialogTrigger, DialogPortal, DialogClose, DialogOverlay, DialogContent, DialogHeader, DialogFooter, DialogTitle, DialogDescription
## slots: dialog-close, dialog-content, dialog-description, dialog-footer, dialog-header, dialog-overlay, dialog-title

component Dialog(label: text, disabled: boolean, open: boolean) layout:overlay style:dialog {
  label "Dialog"
  state open: boolean = false
  title "Dialog"
  action "open"
  action "close"
  action "focus"

  test "opens Dialog" {
    click "open"
    click "close"
  }
  test "disabled Dialog" {
    expect visible "Dialog"
  }
}

component DialogTrigger(label: text, disabled: boolean) layout:inline style:dialog-trigger {
  label "DialogTrigger"
  action "click"
}

