## PillNav
## source: packages/ui/src/components/pill-nav.tsx
## behavior: native component (state, items, tests). Kernel renders.
## exports: PillNavItem, PillNav
## slots: pill-nav, pill-nav-item

component PillNav(label: text, disabled: boolean) layout:stack style:pill-nav {
  label "PillNav"
  item "Home" -> "/"
  item "Next" -> "/next"
  action "navigate"
  action "focus"

  test "navigates PillNav" {
    click "Home"
  }
  test "disabled PillNav" {
    expect visible "PillNav"
  }
}

component PillNavItem(label: text, disabled: boolean) layout:inline style:pill-nav-item {
  label "PillNavItem"
  action "click"
}
