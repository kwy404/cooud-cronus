## Command
## source: packages/ui/src/components/command.tsx
## behavior: native component (state, items, tests). Kernel renders.
## exports: Command, CommandDialog, CommandInput, CommandList, CommandEmpty, CommandGroup, CommandItem, CommandShortcut, CommandSeparator
## slots: command, command-empty, command-group, command-input, command-input-wrapper, command-item, command-list, command-separator, command-shortcut

component Command(label: text, disabled: boolean, open: boolean) layout:overlay style:command {
  label "Command"
  state open: boolean = false
  title "Command"
  action "open"
  action "close"
  action "focus"

  test "opens Command" {
    click "open"
    click "close"
  }
  test "disabled Command" {
    expect visible "Command"
  }
}

