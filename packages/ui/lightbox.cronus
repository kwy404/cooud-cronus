## Lightbox
## source: packages/ui/src/components/lightbox.tsx
## behavior: native component (state, items, tests). Kernel renders.
## exports: LightboxImage, Lightbox
## slots: lightbox, lightbox-caption, lightbox-close, lightbox-counter, lightbox-image, lightbox-thumbnails

component Lightbox(label: text, disabled: boolean, open: boolean) layout:overlay style:lightbox {
  label "Lightbox"
  state open: boolean = false
  title "Lightbox"
  action "open"
  action "close"
  action "focus"

  test "opens Lightbox" {
    click "open"
    click "close"
  }
  test "disabled Lightbox" {
    expect visible "Lightbox"
  }
}

component LightboxImage(label: text, disabled: boolean) layout:inline style:lightbox-image {
  label "LightboxImage"
  action "click"
}
