## Block TypingText
## source: registry/typing-text.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLAttributes, HTMLSpanElement
## registryDependencies: cn

component TypingTextBlock(label: text) layout:stack style:typing-text {
  meta "stack"
  label "TypingText"
  title "children"
  subtitle "Segmenter"
  action "click"
  text "respect"
  text "always"
  text "never"
  text "grapheme"
  test "uses TypingText" {
    click "TypingText"
  }
}
