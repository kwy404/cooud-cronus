## Block AlertDialog
## source: registry/alert-dialog.json
## type: registry:ui
## layout: stack
## compose: AlertDialogPrimitive, AlertDialogOverlay
## icons: HTMLDivElement
## registryDependencies: button, cn

component AlertDialogBlock(label: text) layout:stack style:alert-dialog {
  meta "stack"
  label "AlertDialog"
  title "AlertDialogContent"
  subtitle "AlertDialogHeader"
  slot "AlertDialogPrimitive"
  slot "AlertDialogOverlay"
  action "click"
  text "AlertDialogFooter"
  text "AlertDialogTitle"
  text "AlertDialogDescription"
  text "AlertDialogAction"
  text "AlertDialogCancel"
  test "uses AlertDialog" {
    click "AlertDialog"
  }
}
