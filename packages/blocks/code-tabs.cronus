  subtitle "children"
  slot "Tabs"
  slot "TabsList"
  slot "TabsTrigger"
  slot "CopyButton"
  slot "TabsContent"
  action "click"
  text "bun"
  text "bash"
  text "defaultValue"
  text "dir"
  text "onChange"
  text "storage"
  text "active"
  text "copied"
  test "uses CodeTabs" {
