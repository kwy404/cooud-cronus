## Block TiltCard
## source: registry/tilt-card.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement
## registryDependencies: cn

component TiltCardBlock(label: text) layout:stack style:tilt-card {
  meta "stack"
  label "TiltCard"
  title "0deg"
  subtitle "0deg"
  action "click"
  test "uses TiltCard" {
    click "TiltCard"
  }
}
