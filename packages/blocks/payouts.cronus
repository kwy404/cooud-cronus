## Block Payouts
## source: registry/payouts.json
## type: registry:block
## layout: table-stack
## compose: Card, CardHeader, CardTitle, CardContent, Button, Table, Badge
## icons: Wallet, TableHeader, TableRow, TableHead, TableBody, TableCell

component PayoutsBlock(label: text) layout:stack style:payouts {
  meta "table-stack"
  label "Payouts"
  title "Available balance"
  subtitle "Withdraw"
  slot "Card"
  slot "CardHeader"
  slot "CardTitle"
  slot "CardContent"
  slot "Button"
  slot "Table"
  slot "Badge"
  item "Pending clearance"
  item "Clears in 3 days"
  item "Payout history"
  item "Settlements to your connected bank account."
  item "Payout"
  item "Date"
  text "Destination"
  text "Status"
  text "Amount"
  text "Paid"
  text "In transit"
  text "status"
  text "success"
  text "info"
  text "warning"
  test "use" {
    expect visible "Available balance"
  }
}
