## Block Rating
## source: registry/rating.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: Star, HTMLDivElement, HTMLSpanElement, StarIcon
## registryDependencies: cn

component RatingBlock(label: text) layout:stack style:rating {
  meta "stack"
  label "Rating"
  title "show the committed value"
  subtitle "ArrowRight"
  action "click"
  text "ArrowUp"
  text "ArrowLeft"
  text "ArrowDown"
  text "Home"
  text "End"
  text "rating"
  text "slider"
  test "uses Rating" {
    click "Rating"
  }
}
