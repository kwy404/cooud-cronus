## Block Avatar
## source: registry/avatar.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: AvatarPrimitive
## registryDependencies: cn

component AvatarBlock(label: text) layout:stack style:avatar {
  meta "stack"
  label "Avatar"
  title "AvatarImage"
  subtitle "AvatarFallback"
  action "click"
  text "avatar"
  test "uses Avatar" {
    click "Avatar"
  }
}
