## Block Sparkline
## source: registry/sparkline.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: SparklineTone, SVGAttributes, SVGSVGElement
## registryDependencies: cn

component SparklineBlock(label: text) layout:stack style:sparkline {
  meta "stack"
  label "Sparkline"
  title "currentColor"
  subtitle "sparkline"
  action "click"
  text "success"
  text "warning"
  text "error"
  text "info"
  text "type"
  text "point"
  text "points"
  text "img"
  text "none"
  text "bar"
  test "uses Sparkline" {
    click "Sparkline"
  }
}
