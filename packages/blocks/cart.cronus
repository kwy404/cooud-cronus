## Block Cart
## source: registry/cart.json
## type: registry:block
## behavior: commerce
## registryDependencies: demo-store

component CartBlock(label: text) layout:stack style:cart {
  title "Cart"
  subtitle "Cart"
  field "Card"
  value "$0"
  action "Pay"
  test "checkout" {
    click "Pay"
  }
}
