## Block CtaBanner
## source: registry/cta--banner.json
## type: registry:block
## layout: stack
## compose: Button
## icons: ArrowRight

component CtaBannerBlock(label: text) layout:stack style:cta--banner {
  meta "stack"
  label "CtaBanner"
  title "Ship your next launch on Cronus."
  subtitle "Start free trial"
  slot "Button"
  button "Start free trial" tone:primary
  text "Talk to sales"
  test "cta" {
    click "Start free trial"
  }
}
