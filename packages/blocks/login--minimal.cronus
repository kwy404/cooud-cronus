## Block LoginMinimal
## source: registry/login--minimal.json
## type: registry:block
## layout: form-card
## compose: Label, Input, Button, Separator
## icons: ChartColumnIncreasing
## registryDependencies: auth-adapter

component LoginMinimalBlock(label: text) layout:stack style:login--minimal {
  meta "form-card"
  label "LoginMinimal"
  title "Sign in to Cronus"
  subtitle "Use your work email to continue."
  slot "Label"
  slot "Input"
  slot "Button"
  slot "Separator"
  state pending: boolean = false
  field "Email"
  field "Password"
  action "Create account"
  text "Privacy"
  text "Terms"
  text "Something went wrong."
  text "you@company.com"
  text "alert"
  test "submit" {
    fill email "you@company.com"
    click "Submit"
  }
}
