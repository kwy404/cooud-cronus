component JsonViewerBlock(label: text) layout:stack style:json-viewer {
  meta "stack"
  label "JsonViewer"
  title "| ReadonlySet"
  subtitle "Name: message"
  slot "CopyButton"
  action "click"
  text "object"
  text "array"
  text "map"
  text "set"
  text "item"
  text "items"
  text "entry"
  text "entries"
  text "key"
  text "keys"
  test "uses JsonViewer" {
    click "JsonViewer"
  }
}
