## Block PieChart
## source: registry/pie-chart.json
## type: registry:ui
## behavior: data
## registryDependencies: chart, cn

component PieChartBlock(label: text) layout:stack style:pie-chart {
  title "Pie Chart"
  subtitle "Pie Chart"
  columns "name, value, status"
  item "Row"
  value "0"
  test "reads PieChart" {
    expect visible "Pie Chart"
  }
}
