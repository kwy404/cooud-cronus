  text "Northwind"
  text "Vertex"
  text "Lumina"
  text "Fathom"
  text "Polaris"
  text "Halcyon"
  text "Driftline"
  text "Basalt"
  text "Cascade"
  text "Emberly"
  test "cta" {
    click "Trusted by 4,000+ product teams"
  }
}
