## Block Invoice
## source: registry/invoice.json
## type: registry:block
## behavior: commerce
## registryDependencies: demo-store

component InvoiceBlock(label: text) layout:stack style:invoice {
  title "Invoice"
  subtitle "Invoice"
  field "Card"
  value "$0"
  action "Pay"
  test "checkout" {
    click "Pay"
  }
}
