## Block Switch
## source: registry/switch.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: SwitchPrimitive
## registryDependencies: cn

component SwitchBlock(label: text) layout:stack style:switch {
  meta "stack"
  label "Switch"
  title "switch"
  subtitle "switch"
  action "click"
  test "uses Switch" {
    click "Switch"
  }
}
