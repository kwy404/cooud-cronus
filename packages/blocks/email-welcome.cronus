## Block EmailWelcome
## source: registry/email-welcome.json
## type: registry:block
## layout: stack
## compose: Card, Button

component EmailWelcomeBlock(label: text) layout:stack style:email-welcome {
  meta "stack"
  label "EmailWelcome"
  title "Welcome to Cronus 🎉"
  subtitle "Get started"
  slot "Card"
  slot "Button"
  item "Get started"
  item "Read the quickstart guide"
  item "Invite your team"
  item "Browse starter templates"
  item "Unsubscribe"
  text "Cronus, Inc. · 2261 Market St, San Francisco"
  test "use" {
    expect visible "Cronus"
  }
}
