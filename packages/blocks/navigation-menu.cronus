## Block NavigationMenu
## source: registry/navigation-menu.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: NavigationMenuPrimitive, NavigationMenuViewport, ChevronDown
## registryDependencies: cn

component NavigationMenuBlock(label: text) layout:stack style:navigation-menu {
  meta "stack"
  label "NavigationMenu"
  title "NavigationMenu"
  subtitle "NavigationMenuList"
  action "click"
  text "NavigationMenuItem"
  text "NavigationMenuContent"
  test "uses NavigationMenu" {
    click "NavigationMenu"
  }
}
