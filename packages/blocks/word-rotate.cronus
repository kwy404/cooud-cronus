## Block WordRotate
## source: registry/word-rotate.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLAttributes, HTMLSpanElement, AnimatePresence
## registryDependencies: cn

component WordRotateBlock(label: text) layout:stack style:word-rotate {
  meta "stack"
  label "WordRotate"
  title "motion/react"
  subtitle "children"
  action "click"
  text "user"
  text "never"
  text "always"
  text "polite"
  test "uses WordRotate" {
    click "WordRotate"
  }
}
