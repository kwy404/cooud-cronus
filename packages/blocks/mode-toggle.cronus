## Block ModeToggle
## source: registry/mode-toggle.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: ModeToggleSize, ButtonHTMLAttributes, HTMLButtonElement
## registryDependencies: cn

component ModeToggleBlock(label: text) layout:stack style:mode-toggle {
  meta "stack"
  label "ModeToggle"
  title "light"
  subtitle "dark"
  action "click"
  text "none"
  test "uses ModeToggle" {
    click "ModeToggle"
  }
}
