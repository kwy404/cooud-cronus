## Block MagicLinkSent
## source: registry/magic-link--sent.json
## type: registry:block
## behavior: auth

component MagicLinkSentBlock(label: text) layout:stack style:magic-link--sent {
  title "Magic Link Sent"
  subtitle "Sent"
  state pending: boolean = false
  field "Email"
  field "Password"
  action "Sign in"
  link "Forgot password?" -> "/forgot-password"
  test "submit auth" {
    fill email "you@company.com"
    click "Sign in"
  }
}
