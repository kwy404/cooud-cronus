## Block Toggle
## source: registry/toggle.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: ComponentRef, TogglePrimitive
## registryDependencies: cn

component ToggleBlock(label: text) layout:stack style:toggle {
  meta "stack"
  label "Toggle"
  title "toggle"
  subtitle "Toggle"
  action "click"
  test "uses Toggle" {
    click "Toggle"
  }
}
