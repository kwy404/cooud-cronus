## Block Tabs
## source: registry/tabs.json
## type: registry:ui
## layout: stack
## compose: TabsPrimitive
## registryDependencies: cn

component TabsBlock(label: text) layout:stack style:tabs {
  meta "stack"
  label "Tabs"
  title "TabsList"
  subtitle "TabsContent"
  slot "TabsPrimitive"
  action "click"
  text "tabs"
  test "uses Tabs" {
    click "Tabs"
  }
}
