## Block Testimonials
## source: registry/testimonials.json
## type: registry:block
## layout: stack
## compose: Card, CardContent, Avatar, Badge, AvatarGroup, Marquee
## icons: AvatarImage, AvatarFallback, Sparkles, TestimonialCard

component TestimonialsBlock(label: text) layout:stack style:testimonials {
  meta "stack"
  label "Testimonials"
  title "Loved by teams"
  subtitle "Loved by modern product teams"
  slot "Card"
  slot "CardContent"
  slot "Avatar"
  slot "Badge"
  slot "AvatarGroup"
  slot "Marquee"
  button "Join" tone:primary
  text "teams shipping with Cronus"
  text "Amara Okafor"
  text "Marco Rossi"
  text "Priya Nair"
  text "Jonas Berg"
  text "Sofia Lindqvist"
  text "David Chen"
  text "VP Design, Northwind"
  text "Teams using Cronus"
  test "cta" {
    click "Join"
  }
}
