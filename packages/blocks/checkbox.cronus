## Block Checkbox
## source: registry/checkbox.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: CheckboxPrimitive, Check
## registryDependencies: cn

component CheckboxBlock(label: text) layout:stack style:checkbox {
  meta "stack"
  label "Checkbox"
  title "checkbox"
  subtitle "checkbox"
  action "click"
  test "uses Checkbox" {
    click "Checkbox"
  }
}
