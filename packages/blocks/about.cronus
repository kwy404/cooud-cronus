## Block About
## source: registry/about.json
## type: registry:block
## layout: stack
## compose: Badge, Card, CardContent, Avatar
## icons: Quote, AvatarFallback

component AboutBlock(label: text) layout:stack style:about {
  meta "stack"
  label "About"
  title "Our story"
  subtitle "We believe great software should feel calm, not clever."
  slot "Badge"
  slot "Card"
  slot "CardContent"
  slot "Avatar"
  cta "Our story"
  text "Amara Okafor"
  text "Milestones"
  text "Founded in Copenhagen"
  text "Teammates in 12 countries"
  text "Teams building on Aurora"
  text "Uptime, trailing 12 months"
  text "A weekend prototype"
  text "Seed round"
  text "Aurora 2.0"
  text "Series B"
  test "cta" {
    click "Our story"
  }
}
