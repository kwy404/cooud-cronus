## Block GridPattern
## source: registry/grid-pattern.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement
## registryDependencies: cn

component GridPatternBlock(label: text) layout:stack style:grid-pattern {
  meta "stack"
  label "GridPattern"
  title "userSpaceOnUse"
  subtitle "currentColor"
  action "click"
  text "none"
  test "uses GridPattern" {
    click "GridPattern"
  }
}
