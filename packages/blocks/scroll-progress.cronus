## Block ScrollProgress
## source: registry/scroll-progress.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement, HTMLElement
## registryDependencies: cn

component ScrollProgressBlock(label: text) layout:stack style:scroll-progress {
  meta "stack"
  label "ScrollProgress"
  title "Scroll progress"
  subtitle "progressbar"
  action "click"
  text "circle"
  text "top"
  text "bottom"
  text "scroll"
  text "resize"
  text "none"
  text "-rotate-90"
  text "round"
  test "uses ScrollProgress" {
    click "ScrollProgress"
  }
}
