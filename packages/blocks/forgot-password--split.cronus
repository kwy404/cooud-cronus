## Block ForgotPasswordSplit
## source: registry/forgot-password--split.json
## type: registry:block
## layout: form-card
## compose: Button, Label, Input, Avatar
## icons: ArrowLeft, ChartColumnIncreasing, Quote, AvatarFallback
## registryDependencies: auth-adapter

component ForgotPasswordSplitBlock(label: text) layout:stack style:forgot-password--split {
  meta "form-card"
  label "ForgotPasswordSplit"
  title "We sent a password reset link to"
  subtitle "Check your inbox"
  slot "Button"
  slot "Label"
  slot "Input"
  slot "Avatar"
  state pending: boolean = false
  field "Email"
  field "Password"
  action "Sign in"
  text "Remembered it?"
  text "Use a different email"
  text "Back to sign in"
  text "Reset your password"
  text "Recover your Cronus workspace."
  text "Cronus"
  text "“Cronus replaced four tools on day one — and our checkout conversion is up 23%.”"
  text "Dana Reyes"
  text "Head of Growth, Northwind Labs"
  text "Something went wrong."
  test "submit" {
    fill email "you@company.com"
    click "Submit"
  }
}
