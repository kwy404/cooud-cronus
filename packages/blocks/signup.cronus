## Block Signup
## source: registry/signup.json
## type: registry:block
## behavior: auth
## registryDependencies: auth-adapter, demo-saas

component SignupBlock(label: text) layout:stack style:signup {
  title "Signup"
  subtitle "Signup"
  state pending: boolean = false
  field "Email"
  field "Password"
  action "Sign in"
  link "Forgot password?" -> "/forgot-password"
  test "submit auth" {
    fill email "you@company.com"
    click "Sign in"
  }
}
