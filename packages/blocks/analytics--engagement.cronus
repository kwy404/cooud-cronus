## Block AnalyticsEngagement
## source: registry/analytics--engagement.json
## type: registry:block
## layout: dashboard-grid
## compose: Card, CardContent, Metric, Sparkline, CardHeader, CardTitle, CardDescription, CardAction, Select, SelectTrigger, SelectValue, SelectContent, SelectItem, CardFooter
## icons: MetricLabel, MetricValue, MetricDelta

component AnalyticsEngagementBlock(label: text) layout:stack style:analytics--engagement {
  meta "dashboard-grid"
  label "AnalyticsEngagement"
  title "Weekly cohort retention"
  subtitle "Share of each signup cohort active in the weeks after joining."
  slot "Card"
  slot "CardContent"
  slot "Metric"
  slot "Sparkline"
  slot "CardHeader"
  slot "CardTitle"
  slot "CardDescription"
  slot "CardAction"
  slot "Select"
  slot "SelectTrigger"
  slot "SelectValue"
  slot "SelectContent"
  columns "name, value, status"
  item "Weekly cohort retention"
  item "All workspaces"
  item "Paid workspaces"
  text "Free workspaces"
  text "Cohort"
  text "Retained"
  text "Each row follows one weekly signup cohort through its first 8 weeks."
  text "Less"
  text "More"
  text "Day-1 retention"
  text "Day-7 retention"
  text "Day-30 retention"
  text "Apr 6"
  test "reads" {
    expect visible "Weekly cohort retention"
  }
}
