## Block InvoiceReceipt
## source: registry/invoice--receipt.json
## type: registry:block
## behavior: commerce

component InvoiceReceiptBlock(label: text) layout:stack style:invoice--receipt {
  title "Invoice Receipt"
  subtitle "Receipt"
  field "Card"
  value "$0"
  action "Pay"
  test "checkout" {
    click "Pay"
  }
}
