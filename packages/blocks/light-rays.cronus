## Block LightRays
## source: registry/light-rays.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement
## registryDependencies: cn

component LightRaysBlock(label: text) layout:stack style:light-rays {
  meta "stack"
  label "LightRays"
  title "LightRays"
  subtitle "LightRays"
  action "click"
  test "uses LightRays" {
    click "LightRays"
  }
}
