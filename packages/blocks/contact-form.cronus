## Block ContactForm
## source: registry/contact-form.json
## type: registry:block
## behavior: marketing

component ContactFormBlock(label: text) layout:stack style:contact-form {
  title "Contact Form"
  subtitle "Contact Form"
  action "Get started"
  action "Learn more"
  cta "Get started"
  test "cta" {
    click "Get started"
  }
}
