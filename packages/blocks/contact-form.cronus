## Block ContactForm
## source: registry/contact-form.json
## type: registry:block
## layout: form-card
## compose: Card, CardContent, Label, Input, Textarea, Button
## icons: Mail, MessageCircle, BookOpen

component ContactFormBlock(label: text) layout:stack style:contact-form {
  meta "form-card"
  label "ContactForm"
  title "Get in touch"
  subtitle "Questions, feedback, or partnership ideas — our team usually replies within a day."
  slot "Card"
  slot "CardContent"
  slot "Label"
  slot "Input"
  slot "Textarea"
  slot "Button"
  button "Get in touch"
  text "contact@cronus.com"
  text "Live chat"
  text "Mon–Fri, 9am–6pm"
  text "Docs"
  text "docs.cronus.com"
  text "Name"
  text "Subject"
  text "Message"
  text "Send message"
  text "Mara Castillo"
  test "cta" {
    click "Get in touch"
  }
}
