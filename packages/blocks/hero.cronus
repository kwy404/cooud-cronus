## Block Hero
## source: registry/hero.json
## type: registry:block
## layout: hero-center
## compose: Badge, Button, Avatar
## icons: Sparkles, ArrowRight, AvatarFallback

component HeroBlock(label: text) layout:stack style:hero {
  meta "hero-center"
  label "Hero"
  title "Ship products your team is"
  subtitle "Now in public beta"
  slot "Badge"
  slot "Button"
  slot "Avatar"
  button "Start free trial" tone:primary
  button "Book a demo" tone:primary
  text "proud of"
  text "Loved by"
  text "builders"
  test "cta" {
    click "Book a demo"
  }
}
