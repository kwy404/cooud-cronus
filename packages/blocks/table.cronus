## Block Table
## source: registry/table.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLTableElement, HTMLTableSectionElement, HTMLTableRowElement, HTMLTableCellElement, HTMLTableCaptionElement
## registryDependencies: cn

component TableBlock(label: text) layout:stack style:table {
  meta "stack"
  label "Table"
  title "TableHeader"
  subtitle "TableBody"
  action "click"
  text "table"
  text "TableFooter"
  text "TableRow"
  text "TableCell"
  text "TableCaption"
  test "uses Table" {
    click "Table"
  }
}
