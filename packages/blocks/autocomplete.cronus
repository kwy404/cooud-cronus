## Block Autocomplete
## source: registry/autocomplete.json
## type: registry:ui
## layout: stack
## compose: Popover, Spinner, Skeleton
## icons: HTMLInputElement, AutocompleteOption, HTMLDivElement, HTMLElement, PopoverAnchor, PopoverContent, CommandPrimitive, CommandList
## registryDependencies: cn, command, popover, skeleton, spinner

component AutocompleteBlock(label: text) layout:stack style:autocomplete {
  meta "stack"
  label "Autocomplete"
  title "defaultValue"
  subtitle "onChange"
  slot "Popover"
  slot "Spinner"
  slot "Skeleton"
  action "click"
  text "Promise"
  text "cmdk"
  text "value"
  text "onSelect"
  text "role"
  text "Type to search…"
  text "No results found."
  text "keydown"
  text "ArrowDown"
  text "ArrowUp"
  test "uses Autocomplete" {
    click "Autocomplete"
  }
}
