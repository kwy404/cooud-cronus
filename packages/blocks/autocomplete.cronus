## Block Autocomplete
## source: registry/autocomplete.json
## type: registry:ui
## behavior: card
## registryDependencies: cn, command, popover, skeleton, spinner

component AutocompleteBlock(label: text) layout:stack style:autocomplete {
  title "Autocomplete"
  subtitle "Autocomplete"
  action "Autocomplete"
  test "use block" {
    click "Autocomplete"
  }
}
