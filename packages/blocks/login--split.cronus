## Block LoginSplit
## source: registry/login--split.json
## type: registry:block
## layout: form-card
## compose: Label, Input, Button, Avatar
## icons: ChartColumnIncreasing, Quote, AvatarFallback
## registryDependencies: auth-adapter

component LoginSplitBlock(label: text) layout:stack style:login--split {
  meta "form-card"
  label "LoginSplit"
  title "Welcome back"
  subtitle "Dana Reyes"
  slot "Label"
  slot "Input"
  slot "Button"
  slot "Avatar"
  state pending: boolean = false
  field "Email"
  field "Password"
  action "Sign in"
  link "Forgot password?" -> "/forgot-password"
  text "Sign up"
  text "Cronus"
  text "“Cronus replaced four tools on day one — and our checkout conversion is up 23%.”"
  text "Head of Growth, Northwind Labs"
  text "Something went wrong."
  text "Join the workspace"
  text "Sign in to accept the invitation."
  text "Sign in to your Cronus workspace."
  text "you@company.com"
  text "alert"
  test "submit" {
    fill email "you@company.com"
    click "Submit"
  }
}
