## Block Faq
## source: registry/faq.json
## type: registry:block
## layout: faq-accordion
## compose: Badge, Accordion, AccordionItem, AccordionTrigger, AccordionContent

component FaqBlock(label: text) layout:stack style:faq {
  meta "faq-accordion"
  label "Faq"
  title "Frequently asked questions"
  subtitle "Frequently asked questions"
  slot "Badge"
  slot "Accordion"
  slot "AccordionItem"
  slot "AccordionTrigger"
  slot "AccordionContent"
  item "What exactly do I get with Cronus?"
  item "Do the components work with my existing stack?"
  item "How do themes work?"
  item "Is everything accessible out of the box?"
  item "Can I cancel anytime?"
  cta "FAQ"
  test "cta" {
    click "FAQ"
  }
}
