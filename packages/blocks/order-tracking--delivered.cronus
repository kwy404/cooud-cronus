## Block OrderTrackingDelivered
## source: registry/order-tracking--delivered.json
## type: registry:block
## behavior: commerce
## registryDependencies: demo-store

component OrderTrackingDeliveredBlock(label: text) layout:stack style:order-tracking--delivered {
  title "Order Tracking Delivered"
  subtitle "Delivered"
  field "Card"
  value "$0"
  action "Pay"
  test "checkout" {
    click "Pay"
  }
}
