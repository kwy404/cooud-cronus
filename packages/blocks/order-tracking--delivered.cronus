  slot "Card"
  slot "CardHeader"
  slot "CardTitle"
  slot "Badge"
  slot "CardContent"
  slot "Alert"
  slot "AlertTitle"
  slot "AlertDescription"
  slot "Timeline"
  slot "Separator"
  slot "CardFooter"
  slot "Button"
  action "Pay"
  text "Placed"
  text "Order confirmed"
  text "Payment received and order accepted."
  text "Packed and shipped"
  text "Handed to DHL Express at the Aurora warehouse."
  text "Out for delivery"
  text "Loaded on the delivery vehicle in Portland."
  text "Signed by A. Rivera · front desk."
  text "How was your order?"
