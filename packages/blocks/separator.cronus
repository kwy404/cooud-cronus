## Block Separator
## source: registry/separator.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: SeparatorPrimitive
## registryDependencies: cn

component SeparatorBlock(label: text) layout:stack style:separator {
  meta "stack"
  label "Separator"
  title "horizontal"
  subtitle "separator"
  action "click"
  test "uses Separator" {
    click "Separator"
  }
}
