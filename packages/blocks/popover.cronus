## Block Popover
## source: registry/popover.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: PopoverPrimitive
## registryDependencies: cn

component PopoverBlock(label: text) layout:stack style:popover {
  meta "stack"
  label "Popover"
  title "PopoverContent"
  subtitle "PopoverContent"
  action "click"
  text "center"
  test "uses Popover" {
    click "Popover"
  }
}
