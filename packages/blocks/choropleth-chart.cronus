## Block ChoroplethChart
## source: registry/choropleth-chart.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement
## registryDependencies: cn

component ChoroplethChartBlock(label: text) layout:stack style:choropleth-chart {
  meta "stack"
  label "ChoroplethChart"
  title "Northwest"
  subtitle "Northeast"
  action "click"
  text "West"
  text "Central"
  text "East"
  text "Southwest"
  text "Southeast"
  test "uses ChoroplethChart" {
    click "ChoroplethChart"
  }
}
