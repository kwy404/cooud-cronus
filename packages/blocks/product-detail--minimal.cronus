## Block ProductDetailMinimal
## source: registry/product-detail--minimal.json
## type: registry:block
## layout: checkout-split
## compose: Badge, Button
## icons: Headphones, Star, StarHalf, Minus, Plus, ShoppingCart, ShieldCheck
## registryDependencies: demo-store

component ProductDetailMinimalBlock(label: text) layout:stack style:product-detail--minimal {
  meta "checkout-split"
  label "ProductDetailMinimal"
  title "Limited run"
  subtitle "Aurora Audio"
  slot "Badge"
  slot "Button"
  action "Pay"
  text "Decrease quantity"
  text "Increase quantity"
  text "Add to cart"
  text "Secure checkout · Free shipping · 60-day returns"
  text "aurora"
  text "Product detail"
  test "pay" {
    click "Pay"
  }
}
