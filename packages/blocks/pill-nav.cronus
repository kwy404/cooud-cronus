## Block PillNav
## source: registry/pill-nav.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLAttributes, HTMLElement
## registryDependencies: cn

component PillNavBlock(label: text) layout:stack style:pill-nav {
  meta "stack"
  label "PillNav"
  title "motion/react"
  subtitle "onChange"
  action "click"
  text "next"
  text "prev"
  text "first"
  text "last"
  text "ArrowRight"
  text "ArrowDown"
  text "ArrowLeft"
  text "ArrowUp"
  text "Home"
  text "End"
  test "uses PillNav" {
    click "PillNav"
  }
}
