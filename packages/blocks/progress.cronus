## Block Progress
## source: registry/progress.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: ProgressPrimitive
## registryDependencies: cn

component ProgressBlock(label: text) layout:stack style:progress {
  meta "stack"
  label "Progress"
  title "progressbar"
  subtitle "Upload progress"
  action "click"
  test "uses Progress" {
    click "Progress"
  }
}
