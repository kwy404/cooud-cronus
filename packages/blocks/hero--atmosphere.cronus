## Block HeroAtmosphere
## source: registry/hero--atmosphere.json
## type: registry:block
## layout: hero-center
## compose: RetroGrid, Meteors, Badge, Highlighter, TypingText, Button
## icons: Sparkles, ArrowRight

component HeroAtmosphereBlock(label: text) layout:stack style:hero--atmosphere {
  meta "hero-center"
  label "HeroAtmosphere"
  title "A product UI system: compose the app, theme it live, and keep the copy-in you can"
  subtitle "Ship products your team is"
  slot "RetroGrid"
  slot "Meteors"
  slot "Badge"
  slot "Highlighter"
  slot "TypingText"
  slot "Button"
  button "Start free trial" tone:primary
  button "Book a demo" tone:primary
  text "Now in public beta"
  text "proud of"
  text "restyle."
  text "ship."
  test "cta" {
    click "Book a demo"
  }
}
