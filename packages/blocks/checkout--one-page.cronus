## Block CheckoutOnePage
## source: registry/checkout--one-page.json
## type: registry:block
## behavior: commerce

component CheckoutOnePageBlock(label: text) layout:stack style:checkout--one-page {
  title "Checkout One Page"
  subtitle "OnePage"
  field "Card"
  value "$0"
  action "Pay"
  test "checkout" {
    click "Pay"
  }
}
