## Block LoginSocialFirst
## source: registry/login--social-first.json
## type: registry:block
## behavior: auth
## registryDependencies: auth-adapter

component LoginSocialFirstBlock(label: text) layout:stack style:login--social-first {
  title "Login Social First"
  subtitle "SocialFirst"
  state pending: boolean = false
  field "Email"
  field "Password"
  action "Sign in"
  link "Forgot password?" -> "/forgot-password"
  test "submit auth" {
    fill email "you@company.com"
    click "Sign in"
  }
}
