## Block LoginSocialFirst
## source: registry/login--social-first.json
## type: registry:block
## layout: form-card
## compose: Card, CardHeader, CardTitle, CardContent, Button, Separator, Label, Input, CardFooter
## icons: ChartColumnIncreasing, Chrome, Github, Apple
## registryDependencies: auth-adapter

component LoginSocialFirstBlock(label: text) layout:stack style:login--social-first {
  meta "form-card"
  label "LoginSocialFirst"
  title "Create an account"
  subtitle "Pick up right where you left off."
  slot "Card"
  slot "CardHeader"
  slot "CardTitle"
  slot "CardContent"
  slot "Button"
  slot "Separator"
  slot "Label"
  slot "Input"
  slot "CardFooter"
  state pending: boolean = false
  field "Email"
  field "Password"
  action "Sign in"
  link "Forgot password?" -> "/forgot-password"
  text "New to Cronus?"
  text "Sign in to Cronus"
  text "Continue with Google"
  text "Continue with GitHub"
  text "Continue with Apple"
  text "or sign in with email"
  text "Forgot?"
  text "Something went wrong."
  text "alert"
  test "submit" {
    fill email "you@company.com"
    click "Submit"
  }
}
