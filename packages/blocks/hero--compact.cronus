## Block HeroCompact
## source: registry/hero--compact.json
## type: registry:block
## layout: hero-center
## compose: Badge, Button
## icons: ArrowRight, Check

component HeroCompactBlock(label: text) layout:stack style:hero--compact {
  meta "hero-center"
  label "HeroCompact"
  title "Copy polished product sections into any React app."
  subtitle "Blocks inherit your theme, radius, color scale, and typography automatically."
  slot "Badge"
  slot "Button"
  cta "New registry"
  text "Browse blocks"
  text "Read docs"
  text "Themeable"
  text "Composable"
  test "cta" {
    click "New registry"
  }
}
