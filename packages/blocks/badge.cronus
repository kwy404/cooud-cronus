## Block Badge
## source: registry/badge.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLSpanElement
## registryDependencies: cn

component BadgeBlock(label: text) layout:stack style:badge {
  meta "stack"
  label "Badge"
  title "badge"
  subtitle "Badge"
  action "click"
  test "uses Badge" {
    click "Badge"
  }
}
