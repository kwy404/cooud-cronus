## Block Highlighter
## source: registry/highlighter.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLSpanElement
## registryDependencies: cn

component HighlighterBlock(label: text) layout:stack style:highlighter {
  meta "stack"
  label "Highlighter"
  title "we highlight the * important bit"
  subtitle "highlighter"
  action "click"
  test "uses Highlighter" {
    click "Highlighter"
  }
}
