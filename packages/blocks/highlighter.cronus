## Block Highlighter
## source: registry/highlighter.json
## type: registry:ui
## behavior: card
## registryDependencies: cn

component HighlighterBlock(label: text) layout:stack style:highlighter {
  title "Highlighter"
  subtitle "Highlighter"
  action "Highlighter"
  test "use block" {
    click "Highlighter"
  }
}
