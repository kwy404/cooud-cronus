component UsageMeterBlock(label: text) layout:stack style:usage-meter {
  title "Usage Meter"
  subtitle "Usage Meter"
  columns "name, value, status"
  item "Row"
  value "0"
  test "reads UsageMeter" {
    expect visible "Usage Meter"
  }
}
