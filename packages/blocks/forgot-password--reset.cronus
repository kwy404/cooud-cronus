## Block ForgotPasswordReset
## source: registry/forgot-password--reset.json
## type: registry:block
## layout: form-card
## compose: Card, CardHeader, CardTitle, CardContent, Label, Input, Button, CardFooter
## icons: KeyRound, ArrowLeft
## registryDependencies: auth-adapter

component ForgotPasswordResetBlock(label: text) layout:stack style:forgot-password--reset {
  meta "form-card"
  label "ForgotPasswordReset"
  title "Set a new password"
  subtitle "Choose a password for your Cronus workspace."
  slot "Card"
  slot "CardHeader"
  slot "CardTitle"
  slot "CardContent"
  slot "Label"
  slot "Input"
  slot "Button"
  slot "CardFooter"
  state pending: boolean = false
  field "Email"
  field "Password"
  action "Submit"
  text "New password"
  text "Must be at least 8 characters."
  text "Confirm password"
  text "Back to sign in"
  text "Something went wrong."
  text "confirm"
  text "alert"
  test "submit" {
    fill email "you@company.com"
    click "Submit"
  }
}
