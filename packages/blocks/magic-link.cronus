## Block MagicLink
## source: registry/magic-link.json
## type: registry:block
## behavior: auth

component MagicLinkBlock(label: text) layout:stack style:magic-link {
  title "Magic Link"
  subtitle "Magic Link"
  state pending: boolean = false
  field "Email"
  field "Password"
  action "Sign in"
  link "Forgot password?" -> "/forgot-password"
  test "submit auth" {
    fill email "you@company.com"
    click "Sign in"
  }
}
