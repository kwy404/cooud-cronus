## Block MagicLink
## source: registry/magic-link.json
## type: registry:block
## layout: form-card
## compose: Card, CardHeader, CardTitle, CardContent, Label, Input, Button, Separator, CardFooter
## icons: Sparkles, Github, Chrome

component MagicLinkBlock(label: text) layout:stack style:magic-link {
  meta "form-card"
  label "MagicLink"
  title "Sign in with a magic link"
  subtitle "Send magic link"
  slot "Card"
  slot "CardHeader"
  slot "CardTitle"
  slot "CardContent"
  slot "Label"
  slot "Input"
  slot "Button"
  slot "Separator"
  slot "CardFooter"
  state pending: boolean = false
  field "Email"
  field "Password"
  action "Sign in"
  text "Prefer a password?"
  text "or continue with"
  text "GitHub"
  text "Google"
  text "you@company.com"
  test "submit" {
    fill email "you@company.com"
    click "Submit"
  }
}
