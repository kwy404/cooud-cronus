## Block AnimatedButton
## source: registry/animated-button.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLButtonElement
## registryDependencies: button, cn, motion-presets

component AnimatedButtonBlock(label: text) layout:stack style:animated-button {
  meta "stack"
  label "AnimatedButton"
  title "motion/react"
  subtitle "AnimatedButton"
  action "click"
  test "uses AnimatedButton" {
    click "AnimatedButton"
  }
}
