## Block Confetti
## source: registry/confetti.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement, HTMLCanvasElement, Particle
## registryDependencies: cn

component ConfettiBlock(label: text) layout:stack style:confetti {
  meta "stack"
  label "Confetti"
  title "confetti"
  subtitle "Confetti"
  action "click"
  text "resize"
  test "uses Confetti" {
    click "Confetti"
  }
}
