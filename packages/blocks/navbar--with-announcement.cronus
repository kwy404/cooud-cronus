## Block NavbarWithAnnouncement
## source: registry/navbar--with-announcement.json
## type: registry:block
## layout: site-chrome
## compose: Badge, Button
## icons: Sparkles, ArrowRight, Hexagon, Menu

component NavbarWithAnnouncementBlock(label: text) layout:stack style:navbar--with-announcement {
  meta "site-chrome"
  label "NavbarWithAnnouncement"
  title "Cronus 2.0 is live — 40 new blocks and a refreshed theme engine."
  subtitle "Read more"
  slot "Badge"
  slot "Button"
  button "Sign in"
  button "Get started"
  text "New"
  text "Features"
  text "Pricing"
  text "Docs"
  text "Changelog"
  test "cta" {
    click "Get started"
  }
}
