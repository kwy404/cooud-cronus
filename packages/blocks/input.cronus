## Block Input
## source: registry/input.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLInputElement
## registryDependencies: cn

component InputBlock(label: text) layout:stack style:input {
  meta "stack"
  label "Input"
  title "input"
  subtitle "input"
  action "click"
  test "uses Input" {
    click "Input"
  }
}
