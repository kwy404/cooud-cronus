## Block TableOfContents
## source: registry/table-of-contents.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLAttributes, HTMLElement, HTMLSpanElement, TableOfContentsItem, HTMLAnchorElement
## registryDependencies: cn

component TableOfContentsBlock(label: text) layout:stack style:table-of-contents {
  meta "stack"
  label "TableOfContents"
  title "children"
  subtitle "On this page"
  action "click"
  text "auto"
  text "scroll"
  text "location"
  text "smooth"
  test "uses TableOfContents" {
    click "TableOfContents"
  }
}
