## Block Ripple
## source: registry/ripple.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement
## registryDependencies: cn

component RippleBlock(label: text) layout:stack style:ripple {
  meta "stack"
  label "Ripple"
  title "ripple"
  subtitle "ripple"
  action "click"
  test "uses Ripple" {
    click "Ripple"
  }
}
