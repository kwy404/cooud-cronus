## Block ContextMenu
## source: registry/context-menu.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: ContextMenuPrimitive, ChevronRight, Check, Circle, HTMLSpanElement
## registryDependencies: cn

component ContextMenuBlock(label: text) layout:stack style:context-menu {
  meta "stack"
  label "ContextMenu"
  title "ContextMenuContent"
  subtitle "ContextMenuCheckboxItem"
  action "click"
  text "ContextMenuRadioItem"
  text "ContextMenuLabel"
  text "ContextMenuSeparator"
  text "ContextMenuShortcut"
  test "uses ContextMenu" {
    click "ContextMenu"
  }
}
