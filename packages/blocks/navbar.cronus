## Block Navbar
## source: registry/navbar.json
## type: registry:block
## layout: site-chrome
## compose: Badge, Button
## icons: Hexagon, Menu

component NavbarBlock(label: text) layout:stack style:navbar {
  meta "site-chrome"
  label "Navbar"
  title "Get started"
  subtitle "Features"
  slot "Badge"
  slot "Button"
  button "Sign in" tone:primary
  button "Get started" tone:primary
  text "Cronus"
  text "Beta"
  text "Pricing"
  text "Docs"
  text "Changelog"
  test "cta" {
    click "Sign in"
  }
}
