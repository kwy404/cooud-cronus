## Block OtpSplit
## source: registry/otp--split.json
## type: registry:block
## layout: form-card
## compose: Button, Avatar
## icons: InputOTP, InputOTPGroup, InputOTPSlot, ArrowLeft, ChartColumnIncreasing, Quote, AvatarFallback

component OtpSplitBlock(label: text) layout:stack style:otp--split {
  meta "form-card"
  label "OtpSplit"
  title "Verify"
  subtitle "Enter the code to continue in your Cronus workspace."
  slot "Button"
  slot "Avatar"
  state pending: boolean = false
  field "Email"
  field "Password"
  action "Verify"
  text "Two-factor authentication"
  text "Resend"
  text "Back to sign in"
  text "“Cronus replaced four tools on day one — and our checkout conversion is up 23%.”"
  text "Dana Reyes"
  text "Head of Growth, Northwind Labs"
  text "6-digit two-factor code"
  test "submit" {
    fill email "you@company.com"
    click "Submit"
  }
}
