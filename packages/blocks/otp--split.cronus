## Block OtpSplit
## source: registry/otp--split.json
## type: registry:block
## behavior: auth

component OtpSplitBlock(label: text) layout:stack style:otp--split {
  title "Otp Split"
  subtitle "Split"
  state pending: boolean = false
  field "Email"
  field "Password"
  action "Sign in"
  link "Forgot password?" -> "/forgot-password"
  test "submit auth" {
    fill email "you@company.com"
    click "Sign in"
  }
}
