## Block DotPattern
## source: registry/dot-pattern.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement
## registryDependencies: cn

component DotPatternBlock(label: text) layout:stack style:dot-pattern {
  meta "stack"
  label "DotPattern"
  title "userSpaceOnUse"
  subtitle "currentColor"
  action "click"
  test "uses DotPattern" {
    click "DotPattern"
  }
}
