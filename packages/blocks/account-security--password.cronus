  slot "CardTitle"
  slot "CardDescription"
  slot "CardContent"
  slot "Label"
  slot "Input"
  slot "Progress"
  slot "CardFooter"
  slot "Button"
  slot "Badge"
  field "Name"
  action "Save"
  text "New password"
