## Block ShinyText
## source: registry/shiny-text.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLSpanElement, Comp
## registryDependencies: cn

component ShinyTextBlock(label: text) layout:stack style:shiny-text {
  meta "stack"
  label "ShinyText"
  title "ShinyText"
  subtitle "ShinyText"
  action "click"
  test "uses ShinyText" {
    click "ShinyText"
  }
}
