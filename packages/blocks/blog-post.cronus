## Block BlogPost
## source: registry/blog-post.json
## type: registry:block
## behavior: marketing

component BlogPostBlock(label: text) layout:stack style:blog-post {
  title "Blog Post"
  subtitle "Blog Post"
  action "Get started"
  action "Learn more"
  cta "Get started"
  test "cta" {
    click "Get started"
  }
}
