## Block BlogPost
## source: registry/blog-post.json
## type: registry:block
## layout: stack
## compose: Badge, Avatar, Separator, Button
## icons: AvatarFallback, Share2, Mail, Link2

component BlogPostBlock(label: text) layout:stack style:blog-post {
  meta "stack"
  label "BlogPost"
  title "Engineering"
  subtitle "12 min read"
  slot "Badge"
  slot "Avatar"
  slot "Separator"
  slot "Button"
  cta "Engineering"
  text "Amara Okafor"
  text "Hierarchy beats whitespace"
  text "“Density is not the enemy of clarity. Vagueness is.”"
  text "What changed for customers"
  text "Share this article"
  text "Share"
  text "Share by email"
  text "Copy link"
  text "Blog post"
  test "cta" {
    click "Engineering"
  }
}
