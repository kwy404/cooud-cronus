## Block Accordion
## source: registry/accordion.json
## type: registry:ui
## layout: stack
## compose: AccordionPrimitive
## icons: ChevronDown
## registryDependencies: cn

component AccordionBlock(label: text) layout:stack style:accordion {
  meta "stack"
  label "Accordion"
  title "AccordionItem"
  subtitle "AccordionItem"
  slot "AccordionPrimitive"
  action "click"
  test "uses Accordion" {
    click "Accordion"
  }
}
