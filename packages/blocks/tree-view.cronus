component TreeViewBlock(label: text) layout:stack style:tree-view {
  meta "stack"
  label "TreeView"
  title "must be used within"
  subtitle "onChange"
  slot "TreeView"
  action "click"
  text "tree"
  text "treeitem"
  text "ArrowDown"
  text "ArrowUp"
  text "ArrowRight"
  text "ArrowLeft"
  text "Home"
  text "End"
  text "Enter"
  text "open"
  test "uses TreeView" {
    click "TreeView"
  }
}
