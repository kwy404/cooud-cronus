## Block ComposedChart
## source: registry/composed-chart.json
## type: registry:ui
## behavior: data
## registryDependencies: chart, cn

component ComposedChartBlock(label: text) layout:stack style:composed-chart {
  title "Composed Chart"
  subtitle "Composed Chart"
  columns "name, value, status"
  item "Row"
  value "0"
  test "reads ComposedChart" {
    expect visible "Composed Chart"
  }
}
