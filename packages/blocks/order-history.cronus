## Block OrderHistory
## source: registry/order-history.json
## type: registry:block
## behavior: commerce
## registryDependencies: demo-store

component OrderHistoryBlock(label: text) layout:stack style:order-history {
  title "Order History"
  subtitle "Order History"
  field "Card"
  value "$0"
  action "Pay"
  test "checkout" {
    click "Pay"
  }
}
