## Block OrderHistory
## source: registry/order-history.json
## type: registry:block
## layout: checkout-split
## compose: Card, CardHeader, CardTitle, CardContent, Table, Badge, DropdownMenu, Button
## icons: TableHeader, TableRow, TableHead, TableBody, TableCell, DropdownMenuTrigger, MoreHorizontal, DropdownMenuContent
## registryDependencies: demo-store

component OrderHistoryBlock(label: text) layout:stack style:order-history {
  meta "checkout-split"
  label "OrderHistory"
  title "Actions for order"
  subtitle "Order history"
  slot "Card"
  slot "CardHeader"
  slot "CardTitle"
  slot "CardContent"
  slot "Table"
  slot "Badge"
  slot "DropdownMenu"
  slot "Button"
  field "4 items"
  field "1 item"
  action "Pay"
  text "Your purchases from the last 90 days."
  text "Date"
  text "Items"
  text "Status"
  text "Total"
  text "View order"
  text "Track shipment"
  text "Download invoice"
  text "Request a return"
  text "Delivered"
  test "pay" {
    click "Pay"
  }
}
