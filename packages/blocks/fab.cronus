## Block Fab
## source: registry/fab.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLButtonElement, AnimatePresence
## registryDependencies: cn, motion-presets

component FabBlock(label: text) layout:stack style:fab {
  meta "stack"
  label "Fab"
  title "motion/react"
  subtitle "fab"
  action "click"
  text "visible"
  test "uses Fab" {
    click "Fab"
  }
}
