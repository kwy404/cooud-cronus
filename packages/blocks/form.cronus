## Block Form
## source: registry/form.json
## type: registry:ui
## layout: stack
## compose: Form, Label
## icons: TFieldValues, FormFieldContextValue, FormFieldContext, Controller, FormItemContextValue, FormField, FormItem, HTMLDivElement
## registryDependencies: cn, label

component FormBlock(label: text) layout:stack style:form {
  meta "stack"
  label "Form"
  title "FormItem"
  subtitle "FormLabel"
  slot "Form"
  slot "Label"
  action "click"
  text "FormControl"
  text "FormDescription"
  test "uses Form" {
    click "Form"
  }
}
