## Block HoverCard
## source: registry/hover-card.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HoverCardPrimitive
## registryDependencies: cn

component HoverCardBlock(label: text) layout:stack style:hover-card {
  meta "stack"
  label "HoverCard"
  title "HoverCardContent"
  subtitle "HoverCardContent"
  action "click"
  text "center"
  test "uses HoverCard" {
    click "HoverCard"
  }
}
