## Block Button
## source: registry/button.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLButtonElement, Comp
## registryDependencies: cn

component ButtonBlock(label: text) layout:stack style:button {
  meta "stack"
  label "Button"
  title "Button"
  subtitle "Button"
  action "click"
  test "uses Button" {
    click "Button"
  }
}
