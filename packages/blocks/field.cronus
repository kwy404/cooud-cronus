## Block Field
## source: registry/field.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement, HTMLLabelElement, HTMLParagraphElement
## registryDependencies: cn

component FieldBlock(label: text) layout:stack style:field {
  meta "stack"
  label "Field"
  title "FieldLabel"
  subtitle "FieldDescription"
  action "click"
  text "field"
  text "alert"
  text "FieldError"
  test "uses Field" {
    click "Field"
  }
}
