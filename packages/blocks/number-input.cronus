## Block NumberInput
## source: registry/number-input.json
## type: registry:ui
## layout: stack
## compose: Button, Input
## icons: HTMLInputElement, Minus, Plus
## registryDependencies: button, cn, input

component NumberInputBlock(label: text) layout:stack style:number-input {
  meta "stack"
  label "NumberInput"
  title "ArrowDown"
  subtitle "PageDown"
  slot "Button"
  slot "Input"
  action "click"
  text "ArrowUp"
  text "PageUp"
  text "Home"
  text "End"
  text "Increment"
  test "uses NumberInput" {
    click "NumberInput"
  }
}
