## Block EmailReceipt
## source: registry/email-receipt.json
## type: registry:block
## layout: stack
## compose: Card, Separator, Button

component EmailReceiptBlock(label: text) layout:stack style:email-receipt {
  meta "stack"
  label "EmailReceipt"
  title "Questions about this charge? Contact"
  subtitle "Receipt from Cronus"
  slot "Card"
  slot "Separator"
  slot "Button"
  item "Receipt from Cronus"
  item "Description"
  item "Qty"
  item "Amount"
  item "Pro plan — monthly"
  item "Additional seats"
  text "Priority support"
  text "Subtotal"
  text "Total"
  text "View invoice"
  text "support@cronus.com"
  text "Cronus, Inc. · 2261 Market St, San Francisco"
  test "use" {
    expect visible "Questions about this charge? Contact"
  }
}
