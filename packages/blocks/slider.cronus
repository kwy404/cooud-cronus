## Block Slider
## source: registry/slider.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: SliderPrimitive
## registryDependencies: cn

component SliderBlock(label: text) layout:stack style:slider {
  meta "stack"
  label "Slider"
  title "slider"
  subtitle "Volume"
  action "click"
  test "uses Slider" {
    click "Slider"
  }
}
