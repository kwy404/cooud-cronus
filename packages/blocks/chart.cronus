## Block Chart
## source: registry/chart.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: ChartContextProps, ChartContainer, ChartContext, ChartStyle, RechartsPrimitive, HTMLDivElement, ChartCursor
## registryDependencies: cn

component ChartBlock(label: text) layout:stack style:chart {
  meta "stack"
  label "Chart"
  title "recharts"
  subtitle "children"
  action "click"
  text "en-US"
  text "ChartContainer"
  text "line"
  text "dot"
  text "dashed"
  text "ChartTooltipContent"
  text "date"
  text "Aug 6"
  text "Aug 7"
  text "day"
  test "uses Chart" {
    click "Chart"
  }
}
