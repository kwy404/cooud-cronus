## Block EmptyStateError
## source: registry/empty-state--error.json
## type: registry:block
## layout: empty-center
## compose: Empty, EmptyTitle, EmptyDescription, EmptyContent, Button
## icons: EmptyIcon, FileQuestion, RefreshCw

component EmptyStateErrorBlock(label: text) layout:stack style:empty-state--error {
  meta "empty-center"
  label "EmptyStateError"
  title "Something went wrong"
  subtitle "Back to dashboard"
  slot "Empty"
  slot "EmptyTitle"
  slot "EmptyDescription"
  slot "EmptyContent"
  slot "Button"
  action "Go home" -> "/"
  text "Try again"
  test "empty" {
    click "Go home"
  }
}
