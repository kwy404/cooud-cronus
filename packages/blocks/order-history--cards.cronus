## Block OrderHistoryCards
## source: registry/order-history--cards.json
## type: registry:block
## behavior: commerce

component OrderHistoryCardsBlock(label: text) layout:stack style:order-history--cards {
  title "Order History Cards"
  subtitle "Cards"
  field "Card"
  value "$0"
  action "Pay"
  test "checkout" {
    click "Pay"
  }
}
