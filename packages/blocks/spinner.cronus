## Block Spinner
## source: registry/spinner.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: SVGSVGElement
## registryDependencies: cn

component SpinnerBlock(label: text) layout:stack style:spinner {
  meta "stack"
  label "Spinner"
  title "Loading"
  subtitle "spinner"
  action "click"
  text "status"
  text "none"
  test "uses Spinner" {
    click "Spinner"
  }
}
