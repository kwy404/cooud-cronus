## Block Otp
## source: registry/otp.json
## type: registry:block
## behavior: auth

component OtpBlock(label: text) layout:stack style:otp {
  title "Otp"
  subtitle "Otp"
  state pending: boolean = false
  field "Email"
  field "Password"
  action "Sign in"
  link "Forgot password?" -> "/forgot-password"
  test "submit auth" {
    fill email "you@company.com"
    click "Sign in"
  }
}
