component PaymentMethodAddCardBlock(label: text) layout:stack style:payment-method--add-card {
  meta "checkout-split"
  label "PaymentMethodAddCard"
  title "Add card"
  subtitle "Enter your card details to add a new payment method."
  slot "Card"
  slot "CardHeader"
  slot "CardTitle"
  slot "CardContent"
  slot "Label"
  slot "Input"
  slot "Switch"
  slot "Separator"
  slot "CardFooter"
  slot "Button"
  field "Card number"
  action "Pay"
  text "Cardholder name"
  text "Expiry"
  text "CVC"
  text "Set as default payment method"
  text "Cancel"
  text "Add a card"
  text "cardholder"
  text "Jane Cooper"
  text "cardnumber"
  text "numeric"
  test "pay" {
    click "Pay"
  }
}
