## Block PaymentMethodAddCard
## source: registry/payment-method--add-card.json
## type: registry:block
## behavior: commerce

component PaymentMethodAddCardBlock(label: text) layout:stack style:payment-method--add-card {
  title "Payment Method Add Card"
  subtitle "AddCard"
  field "Card"
  value "$0"
  action "Pay"
  test "checkout" {
    click "Pay"
  }
}
