## Block CheckoutMultiStep
## source: registry/checkout--multi-step.json
## type: registry:block
## behavior: commerce

component CheckoutMultiStepBlock(label: text) layout:stack style:checkout--multi-step {
  title "Checkout Multi Step"
  subtitle "MultiStep"
  field "Card"
  value "$0"
  action "Pay"
  test "checkout" {
    click "Pay"
  }
}
