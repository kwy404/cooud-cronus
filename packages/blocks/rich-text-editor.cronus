## Block RichTextEditor
## source: registry/rich-text-editor.json
## type: registry:ui
## behavior: card
## registryDependencies: cn, separator, toggle

component RichTextEditorBlock(label: text) layout:stack style:rich-text-editor {
  title "Rich Text Editor"
  subtitle "Rich Text Editor"
  action "Rich Text Editor"
  test "use block" {
    click "Rich Text Editor"
  }
}
