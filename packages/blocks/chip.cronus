## Block Chip
## source: registry/chip.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLAttributes, HTMLElement, VariantProps, ChipLabels, Comp, HTMLButtonElement, Check, HTMLDivElement
## registryDependencies: cn

component ChipBlock(label: text) layout:stack style:chip {
  meta "stack"
  label "Chip"
  title "*/ variant?:"
  subtitle "Backspace"
  action "click"
  text "or a"
  text "solid"
  text "neutral"
  text "success"
  text "warning"
  text "error"
  text "info"
  text "soft"
  text "Remove"
  text "Delete"
  test "uses Chip" {
    click "Chip"
  }
}
