## Block Dock
## source: registry/dock.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement, DockButton, HTMLElement
## registryDependencies: cn

component DockBlock(label: text) layout:stack style:dock {
  meta "stack"
  label "Dock"
  title "motion/react"
  subtitle "dock"
  action "click"
  test "uses Dock" {
    click "Dock"
  }
}
