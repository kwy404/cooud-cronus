## Block BlogList
## source: registry/blog--list.json
## type: registry:block
## layout: stack
## compose: Separator, Badge, Avatar
## icons: AvatarFallback, ArrowRight

component BlogListBlock(label: text) layout:stack style:blog--list {
  meta "stack"
  label "BlogList"
  title "The Aurora Journal"
  subtitle "Notes on building calm software"
  slot "Separator"
  slot "Badge"
  slot "Avatar"
  cta "The Aurora Journal"
  text "Long-form writing from the team — published monthly, no fluff, no filler."
  text "Read article"
  text "A practical guide to design tokens at scale"
  text "The anatomy of an accessible data table"
  text "Pricing experiments we ran so you don't have to"
  text "density"
  text "Engineering"
  test "cta" {
    click "The Aurora Journal"
  }
}
