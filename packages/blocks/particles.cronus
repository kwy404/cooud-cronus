## Block Particles
## source: registry/particles.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement, HTMLCanvasElement, Speck
## registryDependencies: cn

component ParticlesBlock(label: text) layout:stack style:particles {
  meta "stack"
  label "Particles"
  title "particles"
  subtitle "Particles"
  action "click"
  text "resize"
  test "uses Particles" {
    click "Particles"
  }
}
