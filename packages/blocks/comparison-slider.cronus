## Block ComparisonSlider
## source: registry/comparison-slider.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLAttributes, HTMLDivElement, ChevronsLeftRight
## registryDependencies: cn

component ComparisonSliderBlock(label: text) layout:stack style:comparison-slider {
  meta "stack"
  label "ComparisonSlider"
  title "onChange"
  subtitle "Comparison"
  action "click"
  text "before"
  text "after"
  text "ArrowLeft"
  text "ArrowDown"
  text "ArrowRight"
  text "ArrowUp"
  text "Home"
  text "End"
  text "slider"
  text "horizontal"
  test "uses ComparisonSlider" {
    click "ComparisonSlider"
  }
}
