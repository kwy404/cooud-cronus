## Block Billing
## source: registry/billing.json
## type: registry:block
## behavior: commerce
## registryDependencies: demo-saas

component BillingBlock(label: text) layout:stack style:billing {
  title "Billing"
  subtitle "Billing"
  field "Card"
  value "$0"
  action "Pay"
  test "checkout" {
    click "Pay"
  }
}
