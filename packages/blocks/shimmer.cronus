## Block Shimmer
## source: registry/shimmer.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement
## registryDependencies: cn

component ShimmerBlock(label: text) layout:stack style:shimmer {
  meta "stack"
  label "Shimmer"
  title "shimmer"
  subtitle "Shimmer"
  action "click"
  test "uses Shimmer" {
    click "Shimmer"
  }
}
