## Block VideoPlayer
## source: registry/video-player.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement, VideoPlayerLabels, HTMLVideoElement, HTMLButtonElement, HTMLInputElement, Play, Pause, VolumeX
## registryDependencies: cn

component VideoPlayerBlock(label: text) layout:stack style:video-player {
  meta "stack"
  label "VideoPlayer"
  title "Playback speed"
  subtitle "Fullscreen"
  action "click"
  text "video"
  text "Pause"
  text "Mute"
  text "Unmute"
  text "Seek"
  text "Volume"
  text "Exit fullscreen"
  text "square"
  text "wide"
  text "fullscreenchange"
  test "uses VideoPlayer" {
    click "VideoPlayer"
  }
}
