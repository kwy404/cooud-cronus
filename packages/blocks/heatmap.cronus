## Block Heatmap
## source: registry/heatmap.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement
## registryDependencies: cn

component HeatmapBlock(label: text) layout:stack style:heatmap {
  meta "stack"
  label "Heatmap"
  title "Activity heatmap"
  subtitle "More"
  action "click"
  text "Less"
  text "img"
  test "uses Heatmap" {
    click "Heatmap"
  }
}
