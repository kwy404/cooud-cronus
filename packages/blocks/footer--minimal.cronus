## Block FooterMinimal
## source: registry/footer--minimal.json
## type: registry:block
## layout: site-chrome
## compose: native-sections
## icons: Hexagon

component FooterMinimalBlock(label: text) layout:stack style:footer--minimal {
  meta "site-chrome"
  label "FooterMinimal"
  title "© 2026 Cronus. All rights reserved."
  subtitle "© 2026 Cronus. All rights reserved."
  cta "Cronus"
  text "Docs"
  text "Pricing"
  text "Support"
  test "cta" {
    click "Cronus"
  }
}
