## Block FileDropzone
## source: registry/file-dropzone.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLLabelElement, UploadCloud
## registryDependencies: cn

component FileDropzoneBlock(label: text) layout:stack style:file-dropzone {
  meta "stack"
  label "FileDropzone"
  title "Upload files"
  subtitle "Upload files"
  action "click"
  text "browse"
  test "uses FileDropzone" {
    click "FileDropzone"
  }
}
