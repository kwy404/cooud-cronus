## Block CurrencyInput
## source: registry/currency-input.json
## type: registry:ui
## layout: stack
## compose: DropdownMenu
## icons: HTMLInputElement, DropdownMenuTrigger, ChevronDown, DropdownMenuContent, DropdownMenuLabel, DropdownMenuSeparator, DropdownMenuRadioGroup, DropdownMenuRadioItem
## registryDependencies: cn, dropdown-menu

component CurrencyInputBlock(label: text) layout:stack style:currency-input {
  meta "stack"
  label "CurrencyInput"
  title "Currency"
  subtitle "Brazilian Real"
  slot "DropdownMenu"
  action "click"
  text "US Dollar"
  text "Euro"
  text "British Pound"
  text "Japanese Yen"
  text "Chinese Yuan"
  text "Indian Rupee"
  text "Australian Dollar"
  text "Canadian Dollar"
  text "Swiss Franc"
  text "Mexican Peso"
  test "uses CurrencyInput" {
    click "CurrencyInput"
  }
}
