## Block ScatterChart
## source: registry/scatter-chart.json
## type: registry:ui
## behavior: data
## registryDependencies: chart, cn

component ScatterChartBlock(label: text) layout:stack style:scatter-chart {
  title "Scatter Chart"
  subtitle "Scatter Chart"
  columns "name, value, status"
  item "Row"
  value "0"
  test "reads ScatterChart" {
    expect visible "Scatter Chart"
  }
}
