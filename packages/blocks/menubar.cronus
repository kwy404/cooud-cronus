## Block Menubar
## source: registry/menubar.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: MenubarPrimitive, ChevronRight, Check, Circle, HTMLSpanElement
## registryDependencies: cn

component MenubarBlock(label: text) layout:stack style:menubar {
  meta "stack"
  label "Menubar"
  title "MenubarContent"
  subtitle "MenubarCheckboxItem"
  action "click"
  text "menubar"
  text "start"
  text "MenubarRadioItem"
  text "MenubarLabel"
  text "MenubarSeparator"
  text "MenubarShortcut"
  test "uses Menubar" {
    click "Menubar"
  }
}
