## Block Settings
## source: registry/settings.json
## type: registry:block
## layout: form-card
## compose: Card, CardHeader, CardTitle, CardContent, Avatar, Button, Label, Input, Separator, Switch, CardFooter
## icons: Record, AvatarImage, AvatarFallback
## registryDependencies: demo-saas

component SettingsBlock(label: text) layout:stack style:settings {
  meta "form-card"
  label "Settings"
  title "Account settings"
  subtitle "Manage your profile and notification preferences."
  slot "Card"
  slot "CardHeader"
  slot "CardTitle"
  slot "CardContent"
  slot "Avatar"
  slot "Button"
  slot "Label"
  slot "Input"
  slot "Separator"
  slot "Switch"
  slot "CardFooter"
  field "Name"
  action "Save"
  text "Profile"
  text "Change photo"
  text "Full name"
  text "Preferences"
  text "Cancel"
  text "Save changes"
  text "Product updates"
  text "News about features and improvements."
  text "Security alerts"
  text "Get notified about new sign-ins and suspicious activity."
  test "save" {
    click "Save"
  }
}
