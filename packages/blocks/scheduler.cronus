## Block Scheduler
## source: registry/scheduler.json
## type: registry:ui
## layout: stack
## compose: Button
## icons: SchedulerEventColor, HTMLAttributes, HTMLDivElement, Date, ChevronLeft, ChevronRight
## registryDependencies: button, cn

component SchedulerBlock(label: text) layout:stack style:scheduler {
  meta "stack"
  label "Scheduler"
  title "onChange"
  subtitle "defaultValue"
  slot "Button"
  action "click"
  text "Today"
  text "success"
  text "warning"
  text "error"
  text "info"
  text "today"
  text "Event calendar"
  text "yyyy-MM-dd"
  text "EEE"
  text "scheduler"
  test "uses Scheduler" {
    click "Scheduler"
  }
}
