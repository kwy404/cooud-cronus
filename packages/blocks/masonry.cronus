## Block Masonry
## source: registry/masonry.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement, ColumnCount
## registryDependencies: cn

component MasonryBlock(label: text) layout:stack style:masonry {
  meta "stack"
  label "Masonry"
  title "1rem"
  subtitle "masonry"
  action "click"
  test "uses Masonry" {
    click "Masonry"
  }
}
