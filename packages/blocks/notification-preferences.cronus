  slot "CardHeader"
  slot "CardTitle"
  slot "CardDescription"
  slot "CardContent"
  slot "Switch"
  slot "Separator"
  slot "CardFooter"
  slot "Button"
  item "Push"
  item "SMS"
  item "SMS is reserved for critical alerts."
  item "Save preferences"
  item "Sales"
  item "New order"
  text "Every successful checkout."
  text "Payout sent"
  text "When a payout leaves your balance."
  text "Refund requested"
  text "A customer asks for their money back."
  text "Team"
  text "Member joined"
  text "Someone accepts a workspace invite."
  text "Mentions & comments"
  text "Replies and @mentions on your work."
  test "use" {
    expect visible "Notification preferences"
  }
