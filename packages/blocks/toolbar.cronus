## Block Toolbar
## source: registry/toolbar.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement, HTMLButtonElement
## registryDependencies: cn

component ToolbarBlock(label: text) layout:stack style:toolbar {
  meta "stack"
  label "Toolbar"
  title "horizontal"
  subtitle "vertical"
  action "click"
  text "ArrowDown"
  text "ArrowRight"
  text "ArrowUp"
  text "ArrowLeft"
  text "Home"
  text "End"
  text "toolbar"
  text "separator"
  text "ToolbarSeparator"
  text "ToolbarGroup"
  test "uses Toolbar" {
    click "Toolbar"
  }
}
