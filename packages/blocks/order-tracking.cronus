## Block OrderTracking
## source: registry/order-tracking.json
## type: registry:block
## behavior: commerce
## registryDependencies: demo-store

component OrderTrackingBlock(label: text) layout:stack style:order-tracking {
  title "Order Tracking"
  subtitle "Order Tracking"
  field "Card"
  value "$0"
  action "Pay"
  test "checkout" {
    click "Pay"
  }
}
