## Block Empty
## source: registry/empty.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement
## registryDependencies: cn

component EmptyBlock(label: text) layout:stack style:empty {
  meta "stack"
  label "Empty"
  title "EmptyIcon"
  subtitle "EmptyTitle"
  action "click"
  text "empty"
  text "EmptyDescription"
  text "EmptyContent"
  test "uses Empty" {
    click "Empty"
  }
}
