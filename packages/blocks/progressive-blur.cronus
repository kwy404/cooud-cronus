## Block ProgressiveBlur
## source: registry/progressive-blur.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement
## registryDependencies: cn

component ProgressiveBlurBlock(label: text) layout:stack style:progressive-blur {
  meta "stack"
  label "ProgressiveBlur"
  title "scrolls under the chrome"
  subtitle "ProgressiveBlur"
  action "click"
  text "bottom"
  text "6rem"
  text "top"
  test "uses ProgressiveBlur" {
    click "ProgressiveBlur"
  }
}
