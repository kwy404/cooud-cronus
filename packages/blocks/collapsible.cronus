## Block Collapsible
## source: registry/collapsible.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: CollapsiblePrimitive
## registryDependencies: cn

component CollapsibleBlock(label: text) layout:stack style:collapsible {
  meta "stack"
  label "Collapsible"
  title "CollapsibleContent"
  subtitle "CollapsibleContent"
  action "click"
  test "uses Collapsible" {
    click "Collapsible"
  }
}
