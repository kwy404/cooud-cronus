## Block Alert
## source: registry/alert.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement, HTMLParagraphElement
## registryDependencies: cn

component AlertBlock(label: text) layout:stack style:alert {
  meta "stack"
  label "Alert"
  title "AlertTitle"
  subtitle "AlertDescription"
  action "click"
  text "alert"
  text "status"
  test "uses Alert" {
    click "Alert"
  }
}
