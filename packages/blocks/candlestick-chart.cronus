## Block CandlestickChart
## source: registry/candlestick-chart.json
## type: registry:ui
## behavior: data
## registryDependencies: chart, cn

component CandlestickChartBlock(label: text) layout:stack style:candlestick-chart {
  title "Candlestick Chart"
  subtitle "Candlestick Chart"
  columns "name, value, status"
  item "Row"
  value "0"
  test "reads CandlestickChart" {
    expect visible "Candlestick Chart"
  }
}
