## Block SuccessState
## source: registry/success-state.json
## type: registry:block
## layout: empty-center
## compose: Reveal, Button
## icons: Check

component SuccessStateBlock(label: text) layout:stack style:success-state {
  meta "empty-center"
  label "SuccessState"
  title "Your account is ready. Everything has been configured and is good to go."
  subtitle "Go to dashboard"
  slot "Reveal"
  slot "Button"
  action "Go home" -> "/"
  text "View details"
  test "empty" {
    click "Go home"
  }
}
