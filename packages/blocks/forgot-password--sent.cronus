## Block ForgotPasswordSent
## source: registry/forgot-password--sent.json
## type: registry:block
## layout: form-card
## compose: Card, CardHeader, CardTitle, CardContent, Button, CardFooter
## icons: MailCheck, ArrowLeft

component ForgotPasswordSentBlock(label: text) layout:stack style:forgot-password--sent {
  meta "form-card"
  label "ForgotPasswordSent"
  title "Check your inbox"
  subtitle "We sent a password reset link to you@company.com."
  slot "Card"
  slot "CardHeader"
  slot "CardTitle"
  slot "CardContent"
  slot "Button"
  slot "CardFooter"
  state pending: boolean = false
  field "Email"
  field "Password"
  action "Submit"
  text "Resend email"
  text "Back to sign in"
  test "submit" {
    fill email "you@company.com"
    click "Submit"
  }
}
