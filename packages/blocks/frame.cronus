## Block Frame
## source: registry/frame.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement
## registryDependencies: cn

component FrameBlock(label: text) layout:stack style:frame {
  meta "stack"
  label "Frame"
  title "browser"
  subtitle "window"
  action "click"
  text "frame"
  test "uses Frame" {
    click "Frame"
  }
}
