## Block CardStack
## source: registry/card-stack.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLAttributes, HTMLElement, HTMLDivElement
## registryDependencies: cn

component CardStackBlock(label: text) layout:stack style:card-stack {
  meta "stack"
  label "CardStack"
  title "motion/react"
  subtitle "children"
  action "click"
  text "Card stack"
  text "Show next card"
  text "Enter"
  text "top center"
  text "spring"
  test "uses CardStack" {
    click "CardStack"
  }
}
