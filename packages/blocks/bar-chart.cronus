## Block BarChart
## source: registry/bar-chart.json
## type: registry:ui
## behavior: data
## registryDependencies: chart, cn

component BarChartBlock(label: text) layout:stack style:bar-chart {
  title "Bar Chart"
  subtitle "Bar Chart"
  columns "name, value, status"
  item "Row"
  value "0"
  test "reads BarChart" {
    expect visible "Bar Chart"
  }
}
