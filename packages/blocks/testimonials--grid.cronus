## Block TestimonialsGrid
## source: registry/testimonials--grid.json
## type: registry:block
## layout: stack
## compose: Badge, AvatarGroup, Card, CardContent, Avatar
## icons: Sparkles, AvatarImage, AvatarFallback

component TestimonialsGridBlock(label: text) layout:stack style:testimonials--grid {
  meta "stack"
  label "TestimonialsGrid"
  title "Loved by teams"
  subtitle "Loved by modern product teams"
  slot "Badge"
  slot "AvatarGroup"
  slot "Card"
  slot "CardContent"
  slot "Avatar"
  button "Join" tone:primary
  text "teams shipping with Cronus"
  text "Amara Okafor"
  text "Marco Rossi"
  text "Priya Nair"
  text "Jonas Berg"
  text "Sofia Lindqvist"
  text "David Chen"
  text "VP Design, Northwind"
  text "Teams using Cronus"
  test "cta" {
    click "Join"
  }
}
