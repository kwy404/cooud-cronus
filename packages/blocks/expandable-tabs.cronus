## Block ExpandableTabs
## source: registry/expandable-tabs.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLAttributes, HTMLDivElement, AnimatePresence
## registryDependencies: cn

component ExpandableTabsBlock(label: text) layout:stack style:expandable-tabs {
  meta "stack"
  label "ExpandableTabs"
  title "motion/react"
  subtitle "onChange"
  action "click"
  text "tablist"
  text "tab"
  text "auto"
  test "uses ExpandableTabs" {
    click "ExpandableTabs"
  }
}
