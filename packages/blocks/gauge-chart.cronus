## Block GaugeChart
## source: registry/gauge-chart.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement, ChartContainer, RadialBarChart, PolarAngleAxis, RadialBar
## registryDependencies: chart, cn

component GaugeChartBlock(label: text) layout:stack style:gauge-chart {
  meta "stack"
  label "GaugeChart"
  title "recharts"
  subtitle "Score"
  action "click"
  text "value"
  text "middle"
  test "uses GaugeChart" {
    click "GaugeChart"
  }
}
