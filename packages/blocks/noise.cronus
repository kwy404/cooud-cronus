## Block Noise
## source: registry/noise.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement
## registryDependencies: cn

component NoiseBlock(label: text) layout:stack style:noise {
  meta "stack"
  label "Noise"
  title "fractalNoise"
  subtitle "fractalNoise"
  action "click"
  text "noise"
  text "stitch"
  test "uses Noise" {
    click "Noise"
  }
}
