## Block TagsInput
## source: registry/tags-input.json
## type: registry:ui
## layout: stack
## compose: Badge
## icons: HTMLInputElement, HTMLDivElement
## registryDependencies: badge, cn

component TagsInputBlock(label: text) layout:stack style:tags-input {
  meta "stack"
  label "TagsInput"
  title "TagsInput"
  subtitle "off"
  slot "Badge"
  action "click"
  text "Enter"
  test "uses TagsInput" {
    click "TagsInput"
  }
}
