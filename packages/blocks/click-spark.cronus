## Block ClickSpark
## source: registry/click-spark.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement, Spark
## registryDependencies: cn

component ClickSparkBlock(label: text) layout:stack style:click-spark {
  meta "stack"
  label "ClickSpark"
  title "ClickSpark"
  subtitle "--dy"
  action "click"
  text "--dx"
  test "uses ClickSpark" {
    click "ClickSpark"
  }
}
