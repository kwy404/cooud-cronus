## Block Kbd
## source: registry/kbd.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLElement
## registryDependencies: cn

component KbdBlock(label: text) layout:stack style:kbd {
  meta "stack"
  label "Kbd"
  title "kbd"
  subtitle "kbd"
  action "click"
  test "uses Kbd" {
    click "Kbd"
  }
}
