## Block Dialog
## source: registry/dialog.json
## type: registry:ui
## layout: stack
## compose: DialogPrimitive, DialogPortal, DialogOverlay
## icons: HTMLDivElement
## registryDependencies: cn

component DialogBlock(label: text) layout:stack style:dialog {
  meta "stack"
  label "Dialog"
  title "DialogContent"
  subtitle "DialogHeader"
  slot "DialogPrimitive"
  slot "DialogPortal"
  slot "DialogOverlay"
  action "click"
  text "Close"
  text "DialogFooter"
  text "DialogTitle"
  text "DialogDescription"
  test "uses Dialog" {
    click "Dialog"
  }
}
