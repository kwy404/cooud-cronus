## Block Checkout
## source: registry/checkout.json
## type: registry:block
## behavior: commerce
## registryDependencies: demo-store

component CheckoutBlock(label: text) layout:stack style:checkout {
  title "Checkout"
  subtitle "Checkout"
  field "Card"
  value "$0"
  action "Pay"
  test "checkout" {
    click "Pay"
  }
}
