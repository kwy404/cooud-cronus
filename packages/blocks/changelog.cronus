## Block Changelog
## source: registry/changelog.json
## type: registry:block
## layout: stack
## compose: Badge
## icons: ChangeKind, ChangelogRelease

component ChangelogBlock(label: text) layout:stack style:changelog {
  meta "stack"
  label "Changelog"
  title "Changelog"
  subtitle "New features, fixes, and performance work — everything that shipped, release by release."
  slot "Badge"
  cta "Changelog"
  text "Latest"
  text "Spotlight effects and timeline primitives"
  text "Theming without the flash"
  text "Feature"
  text "Fix"
  text "Perf"
  text "success"
  text "info"
  text "warning"
  test "cta" {
    click "Changelog"
  }
}
