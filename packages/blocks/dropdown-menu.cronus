## Block DropdownMenu
## source: registry/dropdown-menu.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: DropdownMenuPrimitive, ChevronRight, Check, Circle, HTMLSpanElement
## registryDependencies: cn

component DropdownMenuBlock(label: text) layout:stack style:dropdown-menu {
  meta "stack"
  label "DropdownMenu"
  title "DropdownMenuContent"
  subtitle "DropdownMenuCheckboxItem"
  action "click"
  text "DropdownMenuRadioItem"
  text "DropdownMenuLabel"
  text "DropdownMenuSeparator"
  text "DropdownMenuShortcut"
  test "uses DropdownMenu" {
    click "DropdownMenu"
  }
}
