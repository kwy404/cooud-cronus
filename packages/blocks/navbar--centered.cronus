## Block NavbarCentered
## source: registry/navbar--centered.json
## type: registry:block
## layout: site-chrome
## compose: Button
## icons: Hexagon, Menu

component NavbarCenteredBlock(label: text) layout:stack style:navbar--centered {
  meta "site-chrome"
  label "NavbarCentered"
  title "Get started"
  subtitle "Features"
  slot "Button"
  button "Get started"
  text "Cronus"
  text "Pricing"
  text "Docs"
  text "Changelog"
  test "cta" {
    click "Get started"
  }
}
