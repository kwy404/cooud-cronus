## Block GlassCard
## source: registry/glass-card.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement
## registryDependencies: cn

component GlassCardBlock(label: text) layout:stack style:glass-card {
  meta "stack"
  label "GlassCard"
  title "GlassCard"
  subtitle "GlassCard"
  action "click"
  test "uses GlassCard" {
    click "GlassCard"
  }
}
