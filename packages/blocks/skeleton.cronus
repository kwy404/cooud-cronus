## Block Skeleton
## source: registry/skeleton.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement
## registryDependencies: cn

component SkeletonBlock(label: text) layout:stack style:skeleton {
  meta "stack"
  label "Skeleton"
  title "skeleton"
  subtitle "Skeleton"
  action "click"
  test "uses Skeleton" {
    click "Skeleton"
  }
}
