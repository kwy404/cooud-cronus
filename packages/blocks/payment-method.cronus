## Block PaymentMethod
## source: registry/payment-method.json
## type: registry:block
## layout: checkout-split
## compose: Card, CardHeader, CardTitle, CardContent, RadioGroup, Label, Badge, Button, Separator, CardFooter
## icons: CreditCard, RadioGroupItem

component PaymentMethodBlock(label: text) layout:stack style:payment-method {
  meta "checkout-split"
  label "PaymentMethod"
  title "Payment method"
  subtitle "Choose how you'd like to be billed."
  slot "Card"
  slot "CardHeader"
  slot "CardTitle"
  slot "CardContent"
  slot "RadioGroup"
  slot "Label"
  slot "Badge"
  slot "Button"
  slot "Separator"
  slot "CardFooter"
  action "Pay"
  text "Expires"
  text "Cancel"
  text "Save"
  text "Visa"
  text "Mastercard"
  text "Saved payment methods"
  test "pay" {
    click "Pay"
  }
}
