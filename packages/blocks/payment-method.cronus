## Block PaymentMethod
## source: registry/payment-method.json
## type: registry:block
## behavior: commerce

component PaymentMethodBlock(label: text) layout:stack style:payment-method {
  title "Payment Method"
  subtitle "Payment Method"
  field "Card"
  value "$0"
  action "Pay"
  test "checkout" {
    click "Pay"
  }
}
