## Block StatusDot
## source: registry/status-dot.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: VariantProps, StatusDotStatus, StatusDotPosition, StatusDotSize, HTMLAttributes, HTMLSpanElement
## registryDependencies: cn

component StatusDotBlock(label: text) layout:stack style:status-dot {
  meta "stack"
  label "StatusDot"
  title "StatusDot"
  subtitle "Online"
  action "click"
  text "offline"
  text "Offline"
  text "Busy"
  text "Away"
  text "Success"
  text "Warning"
  text "Error"
  text "Info"
  text "Neutral"
  text "right"
  test "uses StatusDot" {
    click "StatusDot"
  }
}
