component OrderTrackingDelayedBlock(label: text) layout:stack style:order-tracking--delayed {
  meta "checkout-split"
  label "OrderTrackingDelayed"
  title "Your delivery is running late"
  subtitle "Order confirmed"
  slot "Card"
  slot "CardHeader"
  slot "CardTitle"
  slot "Badge"
  slot "CardContent"
  slot "Alert"
  slot "AlertTitle"
  slot "AlertDescription"
  slot "Timeline"
  slot "Separator"
  slot "CardFooter"
  slot "Avatar"
  action "Pay"
  text "Payment received and order accepted."
  text "Packed and shipped"
  text "Handed to DHL Express at the Aurora warehouse."
  text "Held at sorting hub"
  text "Severe weather in Memphis is delaying outbound trucks."
  text "Delivered"
  text "New estimate Jul 19"
  text "DHL Express"
  text "Request a refund"
  text "Contact support"
  test "pay" {
    click "Pay"
  }
}
