## Block OrderTrackingDelayed
## source: registry/order-tracking--delayed.json
## type: registry:block
## behavior: commerce

component OrderTrackingDelayedBlock(label: text) layout:stack style:order-tracking--delayed {
  title "Order Tracking Delayed"
  subtitle "Delayed"
  field "Card"
  value "$0"
  action "Pay"
  test "checkout" {
    click "Pay"
  }
}
