## Block Marquee
## source: registry/marquee.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement
## registryDependencies: cn

component MarqueeBlock(label: text) layout:stack style:marquee {
  meta "stack"
  label "Marquee"
  title "motion/react"
  subtitle "respect"
  action "click"
  text "always"
  text "never"
  text "left"
  text "right"
  text "1rem"
  text "forward"
  text "down"
  text "marquee"
  test "uses Marquee" {
    click "Marquee"
  }
}
