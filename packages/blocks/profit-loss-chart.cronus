## Block ProfitLossChart
## source: registry/profit-loss-chart.json
## type: registry:ui
## behavior: data
## registryDependencies: chart, cn

component ProfitLossChartBlock(label: text) layout:stack style:profit-loss-chart {
  title "Profit Loss Chart"
  subtitle "Profit Loss Chart"
  columns "name, value, status"
  item "Row"
  value "0"
  test "reads ProfitLossChart" {
    expect visible "Profit Loss Chart"
  }
}
