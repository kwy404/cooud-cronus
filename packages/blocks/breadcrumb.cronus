## Block Breadcrumb
## source: registry/breadcrumb.json
## type: registry:ui
## behavior: card
## registryDependencies: cn

component BreadcrumbBlock(label: text) layout:stack style:breadcrumb {
  title "Breadcrumb"
  subtitle "Breadcrumb"
  action "Breadcrumb"
  test "use block" {
    click "Breadcrumb"
  }
}
