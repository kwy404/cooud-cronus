## Block ForgotPassword
## source: registry/forgot-password.json
## type: registry:block
## layout: form-card
## compose: Card, CardHeader, CardTitle, CardContent, Button, CardFooter, Label, Input
## icons: MailCheck, ArrowLeft, KeyRound
## registryDependencies: auth-adapter

component ForgotPasswordBlock(label: text) layout:stack style:forgot-password {
  meta "form-card"
  label "ForgotPassword"
  title "We sent a password reset link to"
  subtitle "Check your inbox"
  slot "Card"
  slot "CardHeader"
  slot "CardTitle"
  slot "CardContent"
  slot "Button"
  slot "CardFooter"
  slot "Label"
  slot "Input"
  state pending: boolean = false
  field "Email"
  field "Password"
  action "Submit"
  text "Use a different email"
  text "Back to sign in"
  text "Reset your password"
  text "Something went wrong."
  text "Sending…"
  text "Resend email"
  text "you@company.com"
  text "alert"
  test "submit" {
    fill email "you@company.com"
    click "Submit"
  }
}
