## Block ForgotPassword
## source: registry/forgot-password.json
## type: registry:block
## behavior: auth
## registryDependencies: auth-adapter

component ForgotPasswordBlock(label: text) layout:stack style:forgot-password {
  title "Forgot Password"
  subtitle "Forgot Password"
  state pending: boolean = false
  field "Email"
  field "Password"
  action "Sign in"
  link "Forgot password?" -> "/forgot-password"
  test "submit auth" {
    fill email "you@company.com"
    click "Sign in"
  }
}
