## Block SignupWithPlan
## source: registry/signup--with-plan.json
## type: registry:block
## behavior: auth
## registryDependencies: auth-adapter, demo-saas

component SignupWithPlanBlock(label: text) layout:stack style:signup--with-plan {
  title "Signup With Plan"
  subtitle "WithPlan"
  state pending: boolean = false
  field "Email"
  field "Password"
  action "Sign in"
  link "Forgot password?" -> "/forgot-password"
  test "submit auth" {
    fill email "you@company.com"
    click "Sign in"
  }
}
