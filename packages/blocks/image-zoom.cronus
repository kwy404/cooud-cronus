## Block ImageZoom
## source: registry/image-zoom.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLButtonElement, ImageZoomLabels, ZoomIn
## registryDependencies: cn

component ImageZoomBlock(label: text) layout:stack style:image-zoom {
  meta "stack"
  label "ImageZoom"
  title "Zoom image"
  subtitle "mouse"
  action "click"
  text "Escape"
  text "zoomed"
  text "idle"
  test "uses ImageZoom" {
    click "ImageZoom"
  }
}
