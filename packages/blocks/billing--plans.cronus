## Block BillingPlans
## source: registry/billing--plans.json
## type: registry:block
## behavior: commerce
## registryDependencies: demo-saas

component BillingPlansBlock(label: text) layout:stack style:billing--plans {
  title "Billing Plans"
  subtitle "Plans"
  field "Card"
  value "$0"
  action "Pay"
  test "checkout" {
    click "Pay"
  }
}
