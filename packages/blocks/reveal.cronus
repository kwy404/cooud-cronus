## Block Reveal
## source: registry/reveal.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement
## registryDependencies: motion-presets

component RevealBlock(label: text) layout:stack style:reveal {
  meta "stack"
  label "Reveal"
  title "motion/react"
  subtitle "reveal"
  action "click"
  text "visible"
  test "uses Reveal" {
    click "Reveal"
  }
}
