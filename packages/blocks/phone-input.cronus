component PhoneInputBlock(label: text) layout:stack style:phone-input {
  meta "stack"
  label "PhoneInput"
  title "United States"
  subtitle "Portugal"
  slot "Popover"
  slot "Command"
  action "click"
  text "Brazil"
  text "United Kingdom"
  text "Spain"
  text "France"
  text "Germany"
  text "Italy"
  text "Netherlands"
  text "Mexico"
  text "Argentina"
  text "Chile"
  test "uses PhoneInput" {
    click "PhoneInput"
  }
}
