## Block CartDrawer
## source: registry/cart--drawer.json
## type: registry:block
## behavior: commerce
## registryDependencies: demo-store

component CartDrawerBlock(label: text) layout:stack style:cart--drawer {
  title "Cart Drawer"
  subtitle "Drawer"
  field "Card"
  value "$0"
  action "Pay"
  test "checkout" {
    click "Pay"
  }
}
