## Block CartDrawer
## source: registry/cart--drawer.json
## type: registry:block
## layout: checkout-split
## compose: Badge, Button, Progress
## icons: Package, ShoppingBag
## registryDependencies: demo-store

component CartDrawerBlock(label: text) layout:stack style:cart--drawer {
  meta "checkout-split"
  label "CartDrawer"
  title "Your cart"
  subtitle "Close cart"
  slot "Badge"
  slot "Button"
  slot "Progress"
  field "4 items"
  action "Pay"
  text "Free shipping unlocked"
  text "Subtotal"
  text "Shipping and taxes are calculated at checkout."
  text "Continue shopping"
  test "pay" {
    click "Pay"
  }
}
