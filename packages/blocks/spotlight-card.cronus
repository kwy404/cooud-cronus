## Block SpotlightCard
## source: registry/spotlight-card.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: HTMLDivElement
## registryDependencies: cn

component SpotlightCardBlock(label: text) layout:stack style:spotlight-card {
  meta "stack"
  label "SpotlightCard"
  title "SpotlightCard"
  subtitle "SpotlightCard"
  action "click"
  test "uses SpotlightCard" {
    click "SpotlightCard"
  }
}
