## Block SpotlightCard
## source: registry/spotlight-card.json
## type: registry:ui
## behavior: card
## registryDependencies: cn

component SpotlightCardBlock(label: text) layout:stack style:spotlight-card {
  title "Spotlight Card"
  subtitle "Spotlight Card"
  action "Spotlight Card"
  test "use block" {
    click "Spotlight Card"
  }
}
