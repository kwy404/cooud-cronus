## Block ColorPicker
## source: registry/color-picker.json
## type: registry:ui
## layout: stack
## compose: Label, Input, Popover, Button
## icons: HTMLInputElement, HTMLButtonElement, HTMLDivElement, PopoverTrigger, PopoverContent, ChannelField
## registryDependencies: button, cn, input, label, popover

component ColorPickerBlock(label: text) layout:stack style:color-picker {
  meta "stack"
  label "ColorPicker"
  title "ArrowDown"
  subtitle "ArrowRight"
  slot "Label"
  slot "Input"
  slot "Popover"
  slot "Button"
  action "click"
  text "Value"
  text "decimal"
  text "ArrowUp"
  text "ArrowLeft"
  text "Home"
  text "End"
  text "dialog"
  text "start"
  text "Color picker"
  text "slider"
  test "uses ColorPicker" {
    click "ColorPicker"
  }
}
