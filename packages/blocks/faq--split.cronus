## Block FaqSplit
## source: registry/faq--split.json
## type: registry:block
## layout: faq-accordion
## compose: Badge, Button, Accordion, AccordionItem, AccordionTrigger, AccordionContent

component FaqSplitBlock(label: text) layout:stack style:faq--split {
  meta "faq-accordion"
  label "FaqSplit"
  title "Frequently asked questions"
  subtitle "Our team usually replies within a few hours."
  slot "Badge"
  slot "Button"
  slot "Accordion"
  slot "AccordionItem"
  slot "AccordionTrigger"
  slot "AccordionContent"
  item "Still have questions?"
  item "What exactly do I get with Cronus?"
  item "Do the components work with my existing stack?"
  item "How do themes work?"
  item "Is everything accessible out of the box?"
  item "Can I cancel anytime?"
  cta "FAQ"
  text "Contact support"
  test "cta" {
    click "FAQ"
  }
}
