## Block UsageDashboardPeriod
## source: registry/usage-dashboard--period.json
## type: registry:block
## layout: dashboard-grid
## compose: SegmentedControl, Card, CardContent, Badge, Sparkline, CardHeader, CardTitle
## icons: SegmentedControlItem, UsageMeterLinear, UsageMeterCircular
## registryDependencies: demo-saas

component UsageDashboardPeriodBlock(label: text) layout:stack style:usage-dashboard--period {
  meta "dashboard-grid"
  label "UsageDashboardPeriod"
  title "Last 30 days"
  subtitle "This billing cycle"
  slot "SegmentedControl"
  slot "Card"
  slot "CardContent"
  slot "Badge"
  slot "Sparkline"
  slot "CardHeader"
  slot "CardTitle"
  columns "name, value, status"
  item "Usage"
  item "Last 30 days"
  item "This billing cycle"
  item "Plan usage"
  text "success"
  text "info"
  text "GB /"
  text "trend"
  text "Quotas for this billing cycle."
  text "Consumption in the last 30 days."
  test "reads" {
    expect visible "Usage"
  }
}
