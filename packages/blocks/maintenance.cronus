## Block Maintenance
## source: registry/maintenance.json
## type: registry:block
## layout: empty-center
## compose: Reveal, Input, Button
## icons: Wrench, Clock

component MaintenanceBlock(label: text) layout:stack style:maintenance {
  meta "empty-center"
  label "Maintenance"
  title "Estimated downtime: ~30 minutes"
  subtitle "Notify me"
  slot "Reveal"
  slot "Input"
  slot "Button"
  action "Go home" -> "/"
  text "you@company.com"
  test "empty" {
    click "Go home"
  }
}
