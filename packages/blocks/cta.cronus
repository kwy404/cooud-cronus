## Block Cta
## source: registry/cta.json
## type: registry:block
## layout: stack
## compose: Label, Input, Button
## icons: Send

component CtaBlock(label: text) layout:stack style:cta {
  meta "stack"
  label "Cta"
  title "Email address"
  subtitle "Subscribe"
  slot "Label"
  slot "Input"
  slot "Button"
  button "Subscribe"
  text "Ready to build something great?"
  text "No spam. Unsubscribe at any time."
  text "you@company.com"
  test "cta" {
    click "Subscribe"
  }
}
