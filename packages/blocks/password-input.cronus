## Block PasswordInput
## source: registry/password-input.json
## type: registry:ui
## layout: stack
## compose: Input
## icons: InputHTMLAttributes, HTMLInputElement, EyeOff, Eye
## registryDependencies: cn, input

component PasswordInputBlock(label: text) layout:stack style:password-input {
  meta "stack"
  label "PasswordInput"
  title "Hide password"
  subtitle "Show password"
  slot "Input"
  action "click"
  text "Weak"
  text "Fair"
  text "Good"
  text "Strong"
  text "type"
  test "uses PasswordInput" {
    click "PasswordInput"
  }
}
