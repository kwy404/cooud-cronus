## Block TimePicker
## source: registry/time-picker.json
## type: registry:ui
## layout: stack
## compose: Popover, Button
## icons: HTMLDivElement, ReturnType, HTMLButtonElement, TimeValue, PopoverTrigger, Clock, PopoverContent, TimeColumn
## registryDependencies: button, cn, popover

component TimePickerBlock(label: text) layout:stack style:time-picker {
  meta "stack"
  label "TimePicker"
  title "HH:mm:ss"
  subtitle "Select time"
  slot "Popover"
  slot "Button"
  action "click"
  text "Now"
  text "Done"
  text "start"
  text "center"
  text "end"
  text "period"
  text "auto"
  text "smooth"
  text "ArrowDown"
  text "ArrowUp"
  test "uses TimePicker" {
    click "TimePicker"
  }
}
