## Block Reviews
## source: registry/reviews.json
## type: registry:block
## layout: stack
## compose: Card, CardHeader, CardTitle, CardContent, Progress, Button, Avatar, Badge
## icons: Star, StarHalf, ReviewStars, AvatarFallback
## registryDependencies: demo-store

component ReviewsBlock(label: text) layout:stack style:reviews {
  meta "stack"
  label "Reviews"
  title "Customer reviews"
  subtitle "Based on 1,284 reviews"
  slot "Card"
  slot "CardHeader"
  slot "CardTitle"
  slot "CardContent"
  slot "Progress"
  slot "Button"
  slot "Avatar"
  slot "Badge"
  item "Write a review"
  item "Verified purchase"
  item "img"
  item "4.8 out of 5 stars"
  item "success"
  test "use" {
    expect visible "Customer reviews"
  }
}
