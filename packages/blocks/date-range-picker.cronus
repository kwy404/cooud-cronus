## Block DateRangePicker
## source: registry/date-range-picker.json
## type: registry:ui
## layout: stack
## compose: Popover, Button
## icons: HTMLButtonElement, DateRange, RdpDateRange, PopoverTrigger, CalendarIcon, PopoverContent, Calendar
## registryDependencies: button, calendar, cn, popover

component DateRangePickerBlock(label: text) layout:stack style:date-range-picker {
  meta "stack"
  label "DateRangePicker"
  title "Date range presets"
  subtitle "Pick a date range"
  slot "Popover"
  slot "Button"
  action "click"
  text "align"
  text "LLL dd, y"
  text "start"
  test "uses DateRangePicker" {
    click "DateRangePicker"
  }
}
