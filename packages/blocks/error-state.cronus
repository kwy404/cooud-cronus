## Block ErrorState
## source: registry/error-state.json
## type: registry:block
## layout: empty-center
## compose: Reveal, AlertTriangle, Button
## icons: RotateCw

component ErrorStateBlock(label: text) layout:stack style:error-state {
  meta "empty-center"
  label "ErrorState"
  title "Something went wrong"
  subtitle "An unexpected error occurred while processing your request. Please try again."
  slot "Reveal"
  slot "AlertTriangle"
  slot "Button"
  action "Go home" -> "/"
  text "Try again"
  text "Contact support"
  test "empty" {
    click "Go home"
  }
}
