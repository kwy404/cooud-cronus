## Block Calendar
## source: registry/calendar.json
## type: registry:ui
## layout: stack
## compose: native-sections
## icons: Icon, DayButton, DayPicker
## registryDependencies: button, cn

component CalendarBlock(label: text) layout:stack style:calendar {
  meta "stack"
  label "Calendar"
  title "calendar"
  subtitle "Calendar"
  action "click"
  text "left"
  text "rtl"
  test "uses Calendar" {
    click "Calendar"
  }
}
