## Block ProductGrid
## source: registry/product-grid.json
## type: registry:block
## layout: checkout-split
## compose: Badge, Card, CardHeader, CardTitle, CardFooter, Button
## icons: ArrowUpRight
## registryDependencies: demo-store

component ProductGridBlock(label: text) layout:stack style:product-grid {
  meta "checkout-split"
  label "ProductGrid"
  title "Shop the store"
  subtitle "Digital products from independent creators."
  slot "Badge"
  slot "Card"
  slot "CardHeader"
  slot "CardTitle"
  slot "CardFooter"
  slot "Button"
  field "6 products"
  action "Pay"
  text "Buy now"
  text "Audio"
  text "Accessories"
  test "pay" {
    click "Pay"
  }
}
