## Block AppShell
## source: registry/app-shell.json
## type: registry:ui
## layout: app-shell
## compose: Sidebar
## icons: SidebarProvider, HTMLDivElement, SidebarProviderProps, SidebarInset
## registryDependencies: cn, sidebar

component AppShellBlock(label: text) layout:stack style:app-shell {
  meta "app-shell"
  label "AppShell"
  title "children"
  subtitle "floating"
  slot "Sidebar"
  action "click"
  text "banner"
  text "inset"
  test "uses AppShell" {
    click "AppShell"
  }
}
