## tokens neutral dark
## live style {} — kernel generate_css_vars reads these keys

style {
  theme dark
  preset neutral
  accent "#e4e4e7"
  font "Inter"
  radius 14px
  accent-hex "#e4e4e7"
  background "#111111"
  surface "#191919"
  text "#f4f4f5"
  text-muted "#a1a1aa"
  border "rgba(255,255,255,0.10)"
  primary "oklch(0.93 0 0)"
  ring "oklch(0.55 0 0)"
  success "oklch(0.715 0.155 162.5)"
  warning "oklch(0.769 0.166 70.08)"
  info "oklch(0.715 0.143 215.2)"
  error "oklch(0.704 0.191 22.216)"
}
