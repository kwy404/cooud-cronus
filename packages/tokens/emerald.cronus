## tokens emerald dark
## live style {} — kernel generate_css_vars reads these keys

style {
  theme dark
  preset emerald
  accent "#10b981"
  font "Inter"
  radius 14px
  accent-hex "#10b981"
  background "#09090b"
  surface "#111113"
  text "#fafaf9"
  text-muted "#a1a1aa"
  border "rgba(255,255,255,0.10)"
  primary "oklch(0.74 0.16 160)"
  ring "oklch(0.74 0.16 160)"
  success "oklch(0.52 0.14 160)"
  warning "oklch(0.52 0.12 70)"
  error "oklch(0.55 0.2 25)"
  info "oklch(0.52 0.11 185)"
}
