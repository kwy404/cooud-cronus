## tokens emerald dark
## live style {} — kernel generate_css_vars reads these keys

style {
  theme dark
  preset emerald
  accent "#10b981"
  font "Inter"
  radius 14px
  accent-hex "#10b981"
  background "#09090b"
  surface "#111113"
  text "#fafaf9"
  text-muted "#a1a1aa"
  border "rgba(255,255,255,0.10)"
  success "oklch(0.715 0.155 162.5)"
  warning "oklch(0.769 0.166 70.08)"
  error "oklch(0.645 0.222 16.44)"
  info "oklch(0.74 0.12 185)"
}
