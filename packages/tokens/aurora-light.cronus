## tokens aurora light
## live style {} — kernel generate_css_vars reads these keys

style {
  theme light
  preset aurora
  accent "#0070a3"
  font "Inter"
  radius 14px
  accent-hex "#0070a3"
  background "#ffffff"
  surface "#f4f4f5"
  text "#18181b"
  text-muted "#52525b"
  border "rgba(0,0,0,0.10)"
  success "oklch(0.52 0.15 162)"
  warning "oklch(0.52 0.12 70)"
  info "oklch(0.52 0.16 235)"
  error "oklch(0.55 0.2 25)"
}
