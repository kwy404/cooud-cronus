## tokens sunset dark
## live style {} — kernel generate_css_vars reads these keys

style {
  theme dark
  preset sunset
  accent "#fc9f30"
  font "Inter"
  radius 14px
  accent-hex "#fc9f30"
  background "#09090b"
  surface "#111113"
  text "#fafaf9"
  text-muted "#a1a1aa"
  border "rgba(255,255,255,0.10)"
  success "oklch(0.74 0.16 130)"
  warning "oklch(0.769 0.166 70.08)"
  error "oklch(0.645 0.222 16.44)"
  info "oklch(0.72 0.13 55)"
}
