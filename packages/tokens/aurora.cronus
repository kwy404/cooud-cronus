## tokens aurora dark
## live style {} — kernel generate_css_vars reads these keys

style {
  theme dark
  preset aurora
  accent "#0ea5e9"
  font "Inter"
  radius 14px
  accent-hex "#0ea5e9"
  background "#09090b"
  surface "#111113"
  text "#fafaf9"
  text-muted "#a1a1aa"
  border "rgba(255,255,255,0.10)"
  primary "oklch(0.685 0.169 237.3)"
  ring "oklch(0.685 0.169 237.3)"
  success "oklch(0.715 0.155 162.5)"
  warning "oklch(0.769 0.166 70.08)"
  error "oklch(0.645 0.222 16.44)"
  info "oklch(0.715 0.143 215.2)"
}
