## tokens neutral light
## live style {} — kernel generate_css_vars reads these keys

style {
  theme light
  preset neutral
  accent "#18181b"
  font "Inter"
  radius 14px
  accent-hex "#18181b"
  background "#fafafa"
  surface "#ffffff"
  text "#18181b"
  text-muted "#52525b"
  border "#e4e4e7"
  primary "oklch(0.205 0 0)"
  ring "oklch(0.705 0 0)"
  success "oklch(0.52 0.15 162)"
  warning "oklch(0.52 0.12 70)"
  error "oklch(0.55 0.2 25)"
  info "oklch(0.52 0.16 235)"
}
