## Cooud — dashboard.cooud.com
## Native .cronus only. No TSX, no HTML, no CSS, no style_block, no template.
## Kernel renders. Money is centavos.

app "Cooud" {
  port 4747
  database sqlite "./cooud.db"
  theme dark
}

style {
  theme dark
  accent white
  font "Inter"
  radius lg
}

layout Main {
  sidebar {
    brand "Cooud"
    "Inicio" -> "/" icon:home
    "Analytics" -> "/analytics" icon:monitoring
    "Historico" -> "/history" icon:schedule
    "Rede" -> "/share" icon:share
    "Apps" -> "/apps" icon:apps
    divider
    "Ajustes" -> "/settings" icon:settings
  }
}

entity Wallet {
  label string!
  balance money!
  auto_mode boolean default:"true"
  auto_label string default:"Auto + D3"
}

entity DailyGoal {
  remaining money!
  target money!
}

entity Metric {
  name string!
  amount money default:"0"
  count number default:"0"
}

entity RevenueGoal {
  title string!
  current money! min:0
  target money! min:0
  scope string
}

entity Project {
  name string!
}

entity Transaction {
  occurred date!
  project -> Project
  amount money!
  kind enum [entrada, saida, repasse]
}

entity Payout {
  occurred date!
  amount money!
  status enum [pendente, pago] default:"pendente"
}

page "/" type:dashboard {
  title "Cooud"

  section sidebar {
    brand "Cooud"
    item "Inicio" -> "/" icon:home active:true
    item "Analytics" -> "/analytics" icon:monitoring
    item "Historico" -> "/history" icon:schedule
    item "Rede" -> "/share" icon:share
    item "Apps" -> "/apps" icon:apps
    item "Ajustes" -> "/settings" icon:settings
  }

  section dark-mode {
    label "Tema"
  }

  section page-header {
    title "Saldo"
    subtitle "Auto + D3"
  }

  section kpi {
    title "Saldo"
    value "-R$ 0,23"
    item "Saldo" value:"-R$ 0,23" icon:account_balance_wallet
    item "Receita bruta" value:"R$ 0,00" icon:payments
    item "Receita liquida" value:"R$ 0,00" icon:show_chart
    item "Pedidos" value:"0" icon:shopping_cart
    item "Ticket medio bruto" value:"R$ 0,00" icon:receipt
  }

  section card {
    title "Boost"
    subtitle "Meta do dia"
    item "Faltam hoje" value:"R$ 110,00"
    item "Meta diaria" value:"R$ 110,00"
    action "Transacoes" -> "/" icon:list
    action "Repasses" -> "/history" icon:calendar_month
  }

  section progress {
    title "Meta de faturamento"
    subtitle "COOUD Titanium"
    value "0"
    max "100000"
    item "Receita liquida · todos os projetos"
    item "R$ 0,00"
    item "R$ 100.000,00"
  }

  section tabs {
    title "Movimento"
    item "Transacoes"
    item "Resumo"
  }

  section filters {
    item "Este mes"
    item "Todos os projetos"
  }

  section chart {
    title "Este mes"
    subtitle "01 de set. — 07 de set."
    value "R$ 0,00"
    type line
    bind Transaction { aggregate sum field:amount group_by:occurred interval:day }
  }

  section empty {
    title "Nenhuma transacao"
    subtitle "Este mes · todos os projetos"
  }

  section table {
    title "Transacoes"
    bind Transaction { query all order occurred desc }
    columns "occurred, project, amount, kind"
  }
}

page "/analytics" type:dashboard {
  title "Analytics"

  section sidebar {
    brand "Cooud"
    item "Inicio" -> "/" icon:home
    item "Analytics" -> "/analytics" icon:monitoring active:true
    item "Historico" -> "/history" icon:schedule
    item "Rede" -> "/share" icon:share
    item "Apps" -> "/apps" icon:apps
    item "Ajustes" -> "/settings" icon:settings
  }

  section kpi {
    title "Receita"
    bind Transaction { aggregate sum field:amount }
    item "Receita bruta" value:"R$ 0,00"
    item "Receita liquida" value:"R$ 0,00"
    item "Pedidos" value:"0"
  }

  section chart {
    title "Receita"
    type bar
    bind Transaction { aggregate sum field:amount group_by:occurred interval:month }
  }
}

page "/history" type:list {
  title "Historico"

  section sidebar {
    brand "Cooud"
    item "Inicio" -> "/" icon:home
    item "Analytics" -> "/analytics" icon:monitoring
    item "Historico" -> "/history" icon:schedule active:true
    item "Rede" -> "/share" icon:share
    item "Apps" -> "/apps" icon:apps
    item "Ajustes" -> "/settings" icon:settings
  }

  section table {
    title "Repasses"
    bind Payout { query all order occurred desc }
    columns "occurred, amount, status"
  }

  section empty {
    title "Nenhum repasse"
  }
}

page "/share" type:custom {
  title "Rede"

  section sidebar {
    brand "Cooud"
    item "Inicio" -> "/" icon:home
    item "Analytics" -> "/analytics" icon:monitoring
    item "Historico" -> "/history" icon:schedule
    item "Rede" -> "/share" icon:share active:true
    item "Apps" -> "/apps" icon:apps
    item "Ajustes" -> "/settings" icon:settings
  }

  section empty {
    title "Nada para compartilhar"
  }
}

page "/apps" type:custom {
  title "Apps"

  section sidebar {
    brand "Cooud"
    item "Inicio" -> "/" icon:home
    item "Analytics" -> "/analytics" icon:monitoring
    item "Historico" -> "/history" icon:schedule
    item "Rede" -> "/share" icon:share
    item "Apps" -> "/apps" icon:apps active:true
    item "Ajustes" -> "/settings" icon:settings
  }

  section empty {
    title "Nenhum app"
  }
}

page "/settings" type:form {
  title "Ajustes"

  section sidebar {
    brand "Cooud"
    item "Inicio" -> "/" icon:home
    item "Analytics" -> "/analytics" icon:monitoring
    item "Historico" -> "/history" icon:schedule
    item "Rede" -> "/share" icon:share
    item "Apps" -> "/apps" icon:apps
    item "Ajustes" -> "/settings" icon:settings active:true
  }

  section form {
    title "Conta"
    item "Tema" value:"dark"
    item "Moeda" value:"BRL"
  }
}
